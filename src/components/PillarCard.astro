---
import Icon from './Icon.astro';
import BioVisual from './BioVisual.astro';
import type { Pillar } from '../data/technology';

interface Props {
  pillar: Pillar;
  index: number;
  href?: string;
}

const { pillar, index, href } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag class="pillar" href={href} data-reveal>
  <div class="pillar__media">
    <BioVisual variant={pillar.visual} label={pillar.visualLabel} />
    <span class="pillar__num" aria-hidden="true">0{index + 1}</span>
  </div>
  <div class="pillar__body">
    <span class="pillar__icon"><Icon name={pillar.icon} /></span>
    <h3>{pillar.title}</h3>
    <p class="pillar__metric">{pillar.metric}</p>
    <p class="pillar__text">{pillar.body}</p>
    {
      href && (
        <span class="pillar__more">
          How it works <Icon name="arrow-right" size={16} />
        </span>
      )
    }
  </div>
</Tag>

<style>
  .pillar {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    border-color: var(--glass-border);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  a.pillar:hover {
    color: inherit;
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .pillar__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-100);
  }

  .pillar__media :global(.bv) {
    transition: transform 600ms var(--ease);
  }

  a.pillar:hover .pillar__media :global(.bv) {
    transform: scale(1.04);
  }

  .pillar__num {
    font-family: var(--font-mono) !important;
    position: absolute;
    top: var(--sp-4);
    left: var(--sp-4);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.2);
    backdrop-filter: blur(6px);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 800;
    color: var(--white);
  }

  .pillar__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    flex: 1;
    padding: var(--sp-6) var(--sp-5) var(--sp-5);
  }

  .pillar__icon {
    position: absolute;
    top: -26px;
    right: var(--sp-5);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--gradient-brand);
    color: var(--white);
    box-shadow: 0 10px 20px -10px rgb(29 78 216 / 0.7);
  }

  h3 {
    font-size: var(--fs-xl);
  }

  .pillar__metric {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--teal-700);
  }

  .pillar__text {
    color: var(--text-muted);
  }

  .pillar__more {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: auto;
    padding-top: var(--sp-4);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--brand);
  }

  .pillar__more :global(svg) {
    transition: transform var(--dur) var(--ease);
  }

  a.pillar:hover .pillar__more :global(svg) {
    transform: translateX(3px);
  }
</style>
