---
/**
 * Many desktop visitors have no default mail app, so a bare mailto: link does nothing.
 * On fine-pointer devices, clicking any email link opens this small menu instead:
 * default app, Gmail, Outlook, or copy the address. Phones keep the native behaviour.
 */
import Icon from './Icon.astro';
---

<div class="mailmenu" role="menu" aria-label="Email options" data-mailmenu hidden>
  <p class="mailmenu__addr" data-mailmenu-addr></p>
  <a role="menuitem" href="#" data-mail="app"><Icon name="mail" size={16} /> Open email app</a>
  <a role="menuitem" href="#" data-mail="gmail" target="_blank" rel="noopener noreferrer"
    ><Icon name="arrow-up-right" size={16} /> Compose in Gmail</a
  >
  <a role="menuitem" href="#" data-mail="outlook" target="_blank" rel="noopener noreferrer"
    ><Icon name="arrow-up-right" size={16} /> Compose in Outlook</a
  >
  <button role="menuitem" type="button" data-mail="copy"><Icon name="file" size={16} /> <span>Copy address</span></button>
</div>

<script>
  const menu = document.querySelector<HTMLElement>('[data-mailmenu]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  if (menu) {
    const addrEl = menu.querySelector<HTMLElement>('[data-mailmenu-addr]')!;
    const app = menu.querySelector<HTMLAnchorElement>('[data-mail="app"]')!;
    const gmail = menu.querySelector<HTMLAnchorElement>('[data-mail="gmail"]')!;
    const outlook = menu.querySelector<HTMLAnchorElement>('[data-mail="outlook"]')!;
    const copy = menu.querySelector<HTMLButtonElement>('[data-mail="copy"]')!;
    const copyLabel = copy.querySelector('span')!;
    let opener: HTMLElement | null = null;

    const close = (restoreFocus = false) => {
      if (menu.hidden) return;
      menu.hidden = true;
      if (restoreFocus) opener?.focus();
      opener = null;
    };

    const open = (link: HTMLAnchorElement) => {
      const address = decodeURIComponent(link.href.replace(/^mailto:/, '').split('?')[0]);
      const to = encodeURIComponent(address);
      addrEl.textContent = address;
      app.href = link.href;
      gmail.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${to}`;
      outlook.href = `https://outlook.office.com/mail/deeplink/compose?to=${to}`;
      copyLabel.textContent = 'Copy address';
      copy.dataset.address = address;

      menu.hidden = false;
      const r = link.getBoundingClientRect();
      const w = menu.offsetWidth;
      const h = menu.offsetHeight;
      const left = Math.min(Math.max(8, r.left), window.innerWidth - w - 8);
      const below = r.bottom + 8 + h < window.innerHeight;
      menu.style.left = `${left}px`;
      menu.style.top = `${below ? r.bottom + 8 : Math.max(8, r.top - h - 8)}px`;
      opener = link;
      app.focus();
    };

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest<HTMLAnchorElement>('a[href^="mailto:"]');
      if (link && !menu.contains(link) && finePointer.matches && !e.metaKey && !e.ctrlKey && !e.shiftKey) {
        e.preventDefault();
        if (opener === link) close();
        else open(link);
        return;
      }
      if (!menu.contains(target)) close();
    });

    menu.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('[data-mail]');
      if (!item) return;
      if (item === copy) {
        navigator.clipboard
          ?.writeText(copy.dataset.address ?? '')
          .then(() => (copyLabel.textContent = 'Copied'))
          .catch(() => (copyLabel.textContent = 'Press Ctrl+C to copy'));
        return;
      }
      setTimeout(() => close(), 0);
    });

    menu.addEventListener('keydown', (e) => {
      const items = [...menu.querySelectorAll<HTMLElement>('[data-mail]')];
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'Escape') close(true);
      else if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
      else if (e.key === 'Tab') close();
    });

    window.addEventListener('scroll', () => close(), { passive: true });
    window.addEventListener('resize', () => close());
  }
</script>

<style>
  .mailmenu {
    position: fixed;
    z-index: 60;
    display: grid;
    min-width: 230px;
    padding: 0.4rem;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.96);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 24px 48px -20px rgb(17 34 102 / 0.45);
  }

  .mailmenu[hidden] {
    display: none;
  }

  .mailmenu__addr {
    padding: 0.45rem 0.65rem 0.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-500);
  }

  .mailmenu a,
  .mailmenu button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.55rem 0.65rem;
    border: 0;
    border-radius: 9px;
    background: none;
    color: var(--ink-900);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--dur) var(--ease);
  }

  .mailmenu a:hover,
  .mailmenu a:focus-visible,
  .mailmenu button:hover,
  .mailmenu button:focus-visible {
    background: var(--blue-50);
    color: var(--blue-700);
  }

  .mailmenu :global(svg) {
    flex-shrink: 0;
    color: var(--blue-600);
  }
</style>
