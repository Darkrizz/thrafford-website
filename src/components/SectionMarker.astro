---
/** Section label: "—— Label", with an optional word set in the brand blue. */
interface Props {
  label: string;
  /** Part of the label to highlight in the brand blue, e.g. "Thrafford’s". */
  accent?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { label, accent, align = 'start', class: className } = Astro.props;
const at = accent ? label.indexOf(accent) : -1;
const parts = at >= 0 ? [label.slice(0, at), accent!, label.slice(at + accent!.length)] : [label, '', ''];
---

<p class:list={['marker', `marker--${align}`, className]}>
  <span class="marker__rule" aria-hidden="true"></span>
  <span class="marker__label">
    {parts[0]}{parts[1] && <span class="marker__accent">{parts[1]}</span>}{parts[2]}
  </span>
  {align === 'center' && <span class="marker__rule marker__rule--end" aria-hidden="true"></span>}
</p>

<style>
  .marker {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink-900);
  }

  .marker__label {
    min-width: 0;
    line-height: 1.4;
  }

  .marker__accent {
    color: var(--brand);
  }

  .marker__rule {
    flex: 0 0 24px;
    height: 2px;
    border-radius: 2px;
    background: var(--gradient-brand);
  }

  .marker--center {
    justify-content: center;
  }

  /* Centred labels get a matching rule on the right, mirrored so both fade inwards. */
  .marker__rule--end {
    background: linear-gradient(135deg, #0f8a83, #2c4bc0 48%, #1d3285);
  }

  :global(.section--dark) .marker,
  :global(.on-dark) .marker {
    color: var(--white);
  }

  :global(.section--dark) .marker__accent,
  :global(.on-dark) .marker__accent {
    color: var(--blue-300);
  }
</style>
