---
/** Systematic section marker: "[01] LABEL ———————" */
interface Props {
  label: string;
  index?: string;
  align?: 'start' | 'center';
  class?: string;
}

const { label, index, align = 'start', class: className } = Astro.props;
---

<p class:list={['marker', `marker--${align}`, className]}>
  {index && <span class="marker__index">{index}</span>}
  <span class="marker__label">{label}</span>
  <span class="marker__rule" aria-hidden="true"></span>
</p>

<style>
  .marker {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-700);
  }

  .marker__index {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    background: var(--gradient-brand);
    color: var(--white);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    box-shadow: 0 6px 14px -6px rgb(38 67 196 / 0.6);
  }

  .marker__label {
    flex: 0 1 auto;
    min-width: 0;
    line-height: 1.4;
  }

  .marker__rule {
    position: relative;
    flex: 1;
    min-width: 2rem;
    height: 1px;
    background: linear-gradient(90deg, var(--border-strong), transparent);
  }

  .marker__rule::before {
    content: '';
    position: absolute;
    left: 0;
    top: -3px;
    width: 1px;
    height: 7px;
    background: var(--border-strong);
  }

  .marker--center {
    justify-content: center;
  }

  .marker--center .marker__rule {
    flex: 0 0 56px;
  }

  :global(.section--dark) .marker,
  :global(.on-dark) .marker {
    color: var(--ink-200);
  }

  :global(.section--dark) .marker__rule,
  :global(.on-dark) .marker__rule {
    background: linear-gradient(90deg, rgb(255 255 255 / 0.25), transparent);
  }

  :global(.section--dark) .marker__rule::before,
  :global(.on-dark) .marker__rule::before {
    background: rgb(255 255 255 / 0.3);
  }
</style>
