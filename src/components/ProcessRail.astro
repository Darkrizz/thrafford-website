---
/**
 * Numbered process steps on a connecting rail. The rail fills with the brand gradient
 * when it scrolls into view; vertical on small screens.
 */
interface Props {
  steps: { title: string; body?: string }[];
  /** Tighter variant without step descriptions (used on the homepage). */
  compact?: boolean;
  label?: string;
}

const { steps, compact = false, label = 'Process' } = Astro.props;
---

<ol class:list={['rail', { 'rail--compact': compact }]} aria-label={label} style={`--steps:${steps.length}`} data-reveal>
  {
    steps.map((s, i) => (
      <li class="rail__step" style={`--i:${i}`}>
        <span class="rail__node" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <div class="rail__text">
          <h3 class="rail__title">{s.title}</h3>
          {!compact && s.body && <p class="rail__body">{s.body}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .rail {
    --node: 52px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
    gap: var(--sp-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Track + animated fill, running through the node centres. */
  .rail::before,
  .rail::after {
    content: '';
    position: absolute;
    top: calc(var(--node) / 2 - 1px);
    left: calc(var(--node) / 2);
    right: calc((100% - (var(--steps) - 1) * var(--sp-5)) / var(--steps) - var(--node) / 2);
    height: 2px;
    border-radius: 2px;
  }

  .rail::before {
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 6px, transparent 6px 12px);
  }

  .rail::after {
    background: var(--gradient-brand);
    box-shadow: 0 0 12px rgb(18 158 150 / 0.45);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.6s var(--ease) 0.3s;
  }

  :global(.js) .rail.is-visible::after,
  :global(html:not(.js)) .rail::after {
    transform: scaleX(1);
  }

  .rail__step {
    position: relative;
    display: grid;
    gap: var(--sp-4);
    align-content: start;
  }

  .rail__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    background:
      linear-gradient(var(--surface-raised), var(--surface-raised)) padding-box,
      var(--gradient-brand) border-box;
    border: 2px solid transparent;
    box-shadow: var(--shadow-soft);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--blue-700);
    transition:
      transform 500ms var(--ease),
      background 500ms var(--ease),
      color 500ms var(--ease);
    transition-delay: calc(0.3s + var(--i) * 0.4s);
  }

  /* Each node lights up as the fill reaches it. */
  :global(.js) .rail.is-visible .rail__node {
    background: var(--gradient-brand) padding-box, var(--gradient-brand) border-box;
    color: var(--white);
    transform: scale(1.04);
  }

  .rail__text {
    display: grid;
    gap: var(--sp-2);
  }

  .rail__title {
    font-size: var(--fs-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .rail__body {
    color: var(--ink-700);
    font-size: var(--fs-sm);
  }

  .rail--compact {
    --node: 44px;
  }

  .rail--compact .rail__title {
    font-size: var(--fs-base);
  }

  /* Dark sections */
  :global(.section--dark) .rail__node {
    background:
      linear-gradient(#141b23, #141b23) padding-box,
      var(--gradient-brand) border-box;
    color: var(--blue-300);
  }

  :global(.section--dark) .rail::before {
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.2) 0 6px, transparent 6px 12px);
  }

  :global(.section--dark) .rail__title {
    color: var(--white);
  }

  :global(.section--dark) .rail__body {
    color: var(--ink-200);
  }

  @media (max-width: 760px) {
    .rail {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }

    .rail::before,
    .rail::after {
      top: calc(var(--node) / 2);
      bottom: calc(var(--node) / 2);
      left: calc(var(--node) / 2 - 1px);
      right: auto;
      width: 2px;
      height: auto;
    }

    .rail::before {
      background: repeating-linear-gradient(180deg, var(--border-strong) 0 6px, transparent 6px 12px);
    }

    .rail::after {
      transform-origin: top;
      transform: scaleY(0);
    }

    :global(.js) .rail.is-visible::after,
    :global(html:not(.js)) .rail::after {
      transform: scaleY(1);
    }

    :global(.section--dark) .rail::before {
      background: repeating-linear-gradient(180deg, rgb(255 255 255 / 0.2) 0 6px, transparent 6px 12px);
    }

    .rail__step {
      grid-template-columns: var(--node) 1fr;
      align-items: center;
      gap: var(--sp-4);
    }
  }
</style>
