---
import { partners } from '../data/partners';
---

<ul class="partners" aria-label="Collaborators">
  {
    partners.map((p) => (
      <li class="partner" data-reveal>
        <img src={p.logo} alt={p.name} loading="lazy" decoding="async" />
        <span class="partner__name">{p.name}</span>
      </li>
    ))
  }
</ul>

<style>
  .partners {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-4);
    list-style: none;
  }

  .partner {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    align-items: center;
    gap: var(--sp-3);
    min-height: 168px;
    padding: var(--sp-5) var(--sp-4) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--glass-bg);
    border-color: var(--glass-border);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    text-align: center;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .partner:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .partner img {
    max-height: 68px;
    max-width: 82%;
    width: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 300ms var(--ease);
  }

  .partner:hover img {
    transform: scale(1.04);
  }

  .partner__name {
    font-size: var(--fs-xs);
    line-height: 1.35;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .partners {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-3);
    }

    .partner {
      min-height: 140px;
    }

    .partner img {
      max-height: 56px;
    }
  }
</style>
