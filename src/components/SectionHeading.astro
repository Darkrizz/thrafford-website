---
import SectionMarker from './SectionMarker.astro';

interface Props {
  eyebrow?: string;
  /** Part of the eyebrow set in the brand blue. */
  eyebrowAccent?: string;
  /** Plain-text title. For inline highlights, pass a `title` slot instead. */
  title?: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, eyebrowAccent, title = '', lead, align = 'start', as: Heading = 'h2', id } = Astro.props;
const hasTitleSlot = Astro.slots.has('title');
// Keep hyphenated terms like "CAR-T" from breaking across lines.
const parts = title.split(/(\S+-\S+)/);
---

<header class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  {eyebrow && <SectionMarker label={eyebrow} accent={eyebrowAccent} align={align} />}
  <Heading id={id} class="section-heading__title">
    {hasTitleSlot ? <slot name="title" /> : parts.map((p, i) => (i % 2 ? <span class="nowrap">{p}</span> : p))}
  </Heading>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--sp-5);
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .section-heading__title,
  .section-heading > :global(.lead) {
    max-width: var(--heading-max, 820px);
  }

  .section-heading--center {
    text-align: center;
    justify-items: center;
  }

  .section-heading__title {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-heading);
    line-height: 1.08;
    letter-spacing: var(--ls-heading);
    color: var(--ink-900);
  }

  .lead {
    max-width: 60ch;
  }

  :global(.section--dark) .section-heading__title {
    color: var(--white);
  }
</style>
