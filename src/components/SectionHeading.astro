---
import SectionMarker from './SectionMarker.astro';

interface Props {
  eyebrow?: string;
  /** Section number shown in the marker, e.g. "01". */
  index?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  /** 'md' for headings that sit in a half-width column. */
  size?: 'lg' | 'md';
  as?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, index, title, lead, align = 'start', size = 'lg', as: Heading = 'h2', id } = Astro.props;
// Keep hyphenated terms like "CAR-T" from breaking across lines.
const parts = title.split(/(\S+-\S+)/);
---

<header class:list={['section-heading', `section-heading--${align}`, `section-heading--${size}`]} data-reveal>
  {eyebrow && <SectionMarker label={eyebrow} index={index} align={align} />}
  <Heading id={id} class="section-heading__title">
    {parts.map((p, i) => (i % 2 ? <span class="nowrap">{p}</span> : p))}
  </Heading>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--sp-5);
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .section-heading__title,
  .section-heading > :global(.lead) {
    max-width: var(--heading-max, 820px);
  }

  .section-heading--center {
    text-align: center;
    justify-items: center;
  }

  .section-heading__title {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--ink-900);
  }

  .section-heading--md .section-heading__title {
    font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3.5rem);
  }

  .lead {
    max-width: 60ch;
  }

  :global(.section--dark) .section-heading__title {
    color: var(--white);
  }
</style>
