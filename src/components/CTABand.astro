---
import Button from './Button.astro';
import { contact } from '../data/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Partner with us to bring CAR-T closer to patients',
  body = 'We collaborate with clinicians, hospitals, academia, labs and strategic advisors. Tell us about your programme and we’ll get back to you.',
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta__card" data-reveal>
      <div class="cta__copy">
        <h2 id="cta-title">{title}</h2>
        <p>{body}</p>
      </div>
      <div class="cta__actions">
        <Button href="/contact/" variant="light" size="lg" icon="arrow-right">Start a conversation</Button>
        <Button href={`mailto:${contact.email}`} variant="outline-light" size="lg" icon="mail" iconPosition="start">
          {contact.email}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
  }

  .cta__card {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr auto;
    align-items: center;
    gap: var(--sp-7);
    padding: clamp(2rem, 1.5rem + 3vw, 4rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(520px 320px at 100% 0%, rgb(53 87 222 / 0.35), transparent 70%),
      radial-gradient(420px 300px at 0% 120%, rgb(18 158 150 / 0.25), transparent 70%),
      var(--gradient-dark);
    border: 1px solid rgb(255 255 255 / 0.06);
    color: var(--white);
    overflow: hidden;
    isolation: isolate;
  }

  .cta__card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: linear-gradient(90deg, transparent, black 60%);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 60%);
    z-index: -1;
  }

  h2 {
    font-size: var(--fs-2xl);
    color: var(--white);
    margin-bottom: var(--sp-4);
  }

  p {
    max-width: 56ch;
    color: var(--ink-200);
    font-size: var(--fs-lg);
  }

  .cta__actions {
    display: grid;
    gap: var(--sp-3);
  }

  @media (max-width: 900px) {
    .cta__card {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .cta__actions {
      grid-auto-flow: row;
      justify-items: start;
    }
  }

  @media (max-width: 480px) {
    .cta__actions,
    .cta__actions :global(.btn) {
      width: 100%;
    }

    .cta__actions :global(.btn span) {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
