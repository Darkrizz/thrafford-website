---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeamCard from '../components/TeamCard.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import { teamGroups, capabilities, institutions } from '../data/team';
import { achievements } from '../data/site';
import { memberSlug } from '../utils/slug';
import { profileSlugs } from '../data/leaders';

const everyone = teamGroups.flatMap((g) => g.members);
// Hero constellation: the disciplines the team brings together (no photos).
const disciplines = [
  'Drug discovery',
  'GMP manufacturing',
  'Clinical trials',
  'Pre-clinical models',
  'Patents & licensing',
  'Innovation & start-ups',
  'Biochemistry',
  'Technology development',
];
const nodes = disciplines.map((label, i) => {
  const a = (i / disciplines.length) * Math.PI * 2 - Math.PI / 2;
  const rx = 39;
  const ry = 38;
  return {
    label,
    x: 50 + Math.cos(a) * rx,
    y: 50 + Math.sin(a) * ry,
    d: (i * 0.45).toFixed(2),
  };
});
const leadership = teamGroups.find((g) => g.featured)!;
const otherGroups = teamGroups.filter((g) => !g.featured);
const byName = Object.fromEntries(everyone.map((m) => [m.name, m]));
const capabilityOf = Object.fromEntries(capabilities.map((c) => [c.member, c]));
const shortName = (n: string) => n.replace(/^(Dr|Mr|Ms|Mrs|Prof)\.?\s+/i, '');

const [lead, ...restAchievements] = achievements;
const achievementNotes: Record<string, string> = {
  Publications: 'Peer-reviewed papers and book chapters across pharmacology, biochemistry and drug discovery.',
  Patents: 'Granted and published',
  Grants: 'Research funding secured',
  Awards: 'Honours and recognition',
  Books: 'Authored',
};

// Split the institutions into two counter-moving ticker rows.
const half = Math.ceil(institutions.length / 2);
const tickerRows = [institutions.slice(0, half), institutions.slice(half)];
---

<BaseLayout
  title="Team"
  description="Meet the Thrafford team: scientists with decades of experience in drug discovery, GMP manufacturing, translational research and commercialisation."
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="team-title">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Team</p>
        <h1 id="team-title">Scientists who have taken therapies from bench to clinic.</h1>
        <p class="hero__lead">
          Leadership spanning discovery, manufacturing, translational research and commercialisation — with decades of
          experience in drug discovery, GMP manufacturing and clinical trials.
        </p>
        <div class="hero__actions">
          <Button href="#leadership" icon="arrow-right">Meet the leadership</Button>
          <Button href="/contact/" variant="secondary">Collaborate with us</Button>
        </div>
      </div>

      <figure class="constellation" aria-label="Disciplines our team brings together">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <ellipse cx="50" cy="50" rx="39" ry="38" class="constellation__orbit" />
          <ellipse cx="50" cy="50" rx="24" ry="23" class="constellation__orbit constellation__orbit--inner" />
          {
            nodes.map((n) => (
              <g>
                <line x1="50" y1="50" x2={n.x} y2={n.y} class="constellation__link" />
                <line
                  x1="50"
                  y1="50"
                  x2={n.x}
                  y2={n.y}
                  pathLength="100"
                  class="constellation__signal"
                  style={`animation-delay:${n.d}s`}
                />
              </g>
            ))
          }
        </svg>
        <div class="constellation__core" aria-hidden="true">
          <span class="constellation__pulse"></span>
          <span class="constellation__pulse constellation__pulse--late"></span>
          <img src="/favicon.png" alt="" width="56" height="56" />
        </div>
        <ul class="constellation__nodes">
          {
            nodes.map((n, i) => (
              <li style={`left:${n.x.toFixed(2)}%; top:${n.y.toFixed(2)}%; --i:${i}`}>
                <span class="constellation__dot" aria-hidden="true" />
                {n.label}
              </li>
            ))
          }
        </ul>
      </figure>
    </div>
  </section>

  <!-- Capability chain -->
  <section class="section" aria-labelledby="chain-title">
    <div class="container">
      <SectionHeading
        id="chain-title"
        title="From molecule to market, under one roof"
        lead="Each stage of taking a therapy to patients is led by someone who has done it before."
      />
      <ol class="chain" data-reveal>
        {
          capabilities.map((c, i) => {
            const m = byName[c.member];
            return (
              <li class="chain__stage" style={`--i:${i}`}>
                <span class="chain__node" aria-hidden="true" />
                <p class="chain__name">{c.stage}</p>
                <p class="chain__metric">{c.metric}</p>
                <p class="chain__claim">{c.claim}</p>
                <p class="chain__detail">{c.detail}</p>
                <a class="chain__person" href={`#${memberSlug(c.member)}`}>
                  {m?.photo && <img src={m.photo} alt="" width="40" height="40" loading="lazy" />}
                  <span>{c.member}</span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- Achievements bento -->
  <section class="section section--tight" aria-labelledby="achievements-title">
    <div class="container">
      <h2 id="achievements-title" class="visually-hidden">Collective achievements</h2>
      <ul class="bento">
        <li class="bento__tile bento__tile--hero" data-reveal>
          <p class="bento__kicker">Collective record of the leadership team</p>
          <p class="bento__value">
            {lead.prefix}<span data-count={lead.value}>{lead.value}</span>{lead.suffix}
          </p>
          <p class="bento__label">{lead.label}</p>
          <p class="bento__note">{achievementNotes[lead.label]}</p>
          <a class="bento__link" href="/publications/">Browse the record <Icon name="arrow-right" size={16} /></a>
        </li>
        {
          restAchievements.map((a) => (
            <li class="bento__tile" data-reveal>
              <p class="bento__value">
                {a.prefix}
                <span data-count={a.value}>{a.value}</span>
                {a.suffix}
              </p>
              <p class="bento__label">{a.label}</p>
              <p class="bento__note">{achievementNotes[a.label]}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Institutions ticker -->
  <section class="ticker" aria-labelledby="ticker-title">
    <p class="container ticker__title" id="ticker-title">Where our team has trained and worked</p>
    {
      tickerRows.map((row, r) => (
        <div class:list={['ticker__row', { 'ticker__row--rev': r === 1 }]}>
          <ul class="ticker__track">
            {row.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
          <ul class="ticker__track" aria-hidden="true">
            {row.map((name) => (
              <li>{name}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- Leadership: editorial profiles -->
  <section class="section" id="leadership" aria-labelledby="leadership-title">
    <div class="container">
      <SectionHeading id="leadership-title" title={leadership.title} lead={leadership.description} />
      <div class="profiles">
        {
          leadership.members.map((m, i) => {
            const slug = memberSlug(m.name);
            const cap = capabilityOf[m.name];
            return (
              <article
                class:list={['profile', { 'profile--flip': i % 2 === 1 }]}
                id={slug}
                tabindex="-1"
                aria-labelledby={`${slug}-name`}
                data-reveal
              >
                <div class="profile__media">
                  <div class="profile__frame">
                    <img src={m.photo} alt={`Portrait of ${m.name}`} width="600" height="560" loading="lazy" decoding="async" />
                  </div>
                  {cap && (
                    <p class="profile__stamp">
                      <strong>{cap.metric}</strong>
                      <span>{cap.claim}</span>
                    </p>
                  )}
                </div>
                <div class="profile__body">
                  <p class="profile__role">{m.role}</p>
                  <h3 id={`${slug}-name`}>{m.name}</h3>
                  <p class="profile__headline">{m.headline}</p>
                  {!!m.credentials?.length && (
                    <dl class="profile__creds">
                      {m.credentials.map((c) => (
                        <div>
                          <dt>{c.label}</dt>
                          <dd>{c.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                  {!!m.expertise?.length && (
                    <ul class="profile__tags" aria-label="Areas of expertise">
                      {m.expertise.map((e) => (
                        <li>{e}</li>
                      ))}
                    </ul>
                  )}
                  <div class="profile__actions">
                    {profileSlugs.has(slug) && (
                      <Button href={`/${slug}/`} icon="arrow-right">
                        View details
                      </Button>
                    )}
                    {m.linkedin && (
                      <Button href={m.linkedin} variant="secondary" icon="linkedin" iconPosition="start" external>
                        LinkedIn profile
                      </Button>
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Executive leadership & interns -->
  {
    otherGroups.map((g, i) => (
      <section class:list={['section', { 'section--alt': i % 2 === 0 }]} aria-labelledby={`${g.id}-title`}>
        <div class="container">
          <SectionHeading id={`${g.id}-title`} title={g.title} lead={g.description} />
          <div class:list={['members', { 'members--pair': g.members.length === 2 }]}>
            {g.members.map((m) => (
              <TeamCard member={m} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section section--tight">
    <div class="container">
      <div class="pubs-link glass" data-reveal>
        <span class="pubs-link__icon"><Icon name="file" /></span>
        <div>
          <h2>Explore the research record</h2>
          <p>Peer-reviewed papers, granted and published patents, and book chapters by our team.</p>
        </div>
        <Button href="/publications/" icon="arrow-right">View publications</Button>
      </div>
    </div>
  </section>

  <CTABand title="Collaborate with our team" />
</BaseLayout>

<script>
  const slug = new URLSearchParams(location.search).get('member');
  const target = slug ? document.getElementById(slug) : null;
  if (target) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Stop the browser restoring/adjusting scroll on load, which would cancel the glide.
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    const loaded = new Promise<void>((resolve) =>
      document.readyState === 'complete' ? resolve() : window.addEventListener('load', () => resolve(), { once: true })
    );
    // Start only once fonts and images have settled, so the target does not move mid-scroll.
    Promise.all([loaded, document.fonts?.ready]).then(() => {
      window.setTimeout(() => {
        target.classList.add('is-visible', 'is-highlighted');
        const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 72;
        const rect = target.getBoundingClientRect();
        const room = window.innerHeight - headerH;
        // Centre the card below the header; if it is taller than the view, align its top.
        const offset = rect.height < room ? (room - rect.height) / 2 : 24;
        window.scrollTo({
          top: Math.max(0, rect.top + window.scrollY - headerH - offset),
          behavior: reduced ? 'auto' : 'smooth',
        });
        target.focus({ preventScroll: true });
        history.replaceState(null, '', `${location.pathname}#${slug}`);
      }, 150);
    });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 3vw, 4.5rem) clamp(3rem, 2rem + 3vw, 4.5rem);
    background: linear-gradient(180deg, rgb(238 242 251 / 0.55) 0%, rgb(226 232 245 / 0.2) 100%);
    overflow: hidden;
    isolation: isolate;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(38 67 196 / 0.35), rgb(18 158 150 / 0.35), transparent);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(700px 400px at 85% 0%, rgb(69 101 230 / 0.18), transparent 70%),
      radial-gradient(600px 360px at 10% 100%, rgb(18 158 150 / 0.14), transparent 70%);
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(28 51 148 / 0.06) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgb(28 51 148 / 0.06) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 20%, #000, transparent 75%);
  }

  .hero h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.3rem + 3.8vw, 4.6rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--ink-950);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
  }

  .hero__copy {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }

  .hero__lead {
    max-width: 52ch;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }

  /* Disciplines constellation */
  .constellation {
    position: relative;
    width: 100%;
    max-width: 580px;
    aspect-ratio: 1;
    margin: 0 0 0 auto;
    animation: const-in 1100ms var(--ease) both;
  }

  @keyframes const-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  .constellation svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .constellation__orbit {
    fill: none;
    stroke: rgb(38 67 196 / 0.2);
    stroke-width: 0.25;
    stroke-dasharray: 0.6 1.4;
    vector-effect: non-scaling-stroke;
  }

  .constellation__orbit--inner {
    stroke: rgb(18 158 150 / 0.25);
  }

  .constellation__link {
    stroke: rgb(38 67 196 / 0.18);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* A signal travelling from the core out to each discipline. */
  .constellation__signal {
    stroke: var(--teal-500);
    stroke-width: 0.45;
    stroke-linecap: round;
    stroke-dasharray: 6 100;
    stroke-dashoffset: 6;
    animation: const-signal 3.6s var(--ease) infinite;
  }

  @keyframes const-signal {
    0% {
      stroke-dashoffset: 6;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }

  .constellation__core {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 22%;
    aspect-ratio: 1;
    border: 1px solid rgb(255 255 255 / 0.95);
    border-radius: 50%;
    background:
      radial-gradient(circle at 35% 30%, #ffffff, rgb(255 255 255 / 0.6) 60%),
      var(--surface-raised);
    box-shadow:
      0 0 0 8px rgb(255 255 255 / 0.4),
      0 30px 60px -24px rgb(17 34 102 / 0.5);
    transform: translate(-50%, -50%);
  }

  .constellation__core img {
    position: relative;
    width: 48%;
    height: auto;
  }

  .constellation__pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgb(69 101 230 / 0.45);
    animation: const-pulse 3.6s var(--ease) infinite;
  }

  .constellation__pulse--late {
    animation-delay: 1.8s;
  }

  @keyframes const-pulse {
    from {
      transform: scale(1);
      opacity: 0.8;
    }
    to {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .constellation__nodes {
    list-style: none;
  }

  .constellation__nodes li {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.95);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.78);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 10px 24px -14px rgb(17 34 102 / 0.45);
    color: var(--ink-900);
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    animation: node-in 800ms var(--ease) both;
    animation-delay: calc(0.4s + var(--i) * 0.08s);
  }

  @keyframes node-in {
    from {
      opacity: 0;
      transform: translate(-50%, -30%);
    }
  }

  .constellation__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gradient-brand);
    box-shadow: 0 0 0 3px rgb(69 101 230 / 0.15);
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .constellation {
      margin-inline: auto;
    }
  }

  @media (max-width: 560px) {
    .constellation__nodes li {
      padding: 0.3rem 0.55rem;
      font-size: 0.6875rem;
    }

    .constellation__dot {
      display: none;
    }
  }

  /* ---------- Capability chain ---------- */
  .chain {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-6);
    list-style: none;
  }

  .chain::before,
  .chain::after {
    content: '';
    position: absolute;
    top: 9px;
    left: 10px;
    right: calc((100% - 3 * var(--sp-6)) / 4 - 10px);
    height: 2px;
    border-radius: 2px;
  }

  .chain::before {
    background: repeating-linear-gradient(90deg, var(--border-strong) 0 6px, transparent 6px 12px);
  }

  .chain::after {
    background: var(--gradient-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.8s var(--ease) 0.2s;
  }

  .chain.is-visible::after,
  :global(html:not(.js)) .chain::after {
    transform: scaleX(1);
  }

  .chain__stage {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--sp-2);
    padding-top: var(--sp-7, 2.5rem);
  }

  .chain__node {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--surface-raised);
    border: 2px solid var(--blue-500);
    box-shadow: 0 0 0 5px rgb(69 101 230 / 0.12);
    transition: background-color 500ms var(--ease);
    transition-delay: calc(0.3s + var(--i) * 0.4s);
  }

  .chain.is-visible .chain__node {
    background: var(--blue-500);
  }

  .chain__name {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-700);
  }

  .chain__metric {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.8rem + 2vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--ink-950);
    font-variant-numeric: tabular-nums;
  }

  .chain__claim {
    font-weight: 700;
    color: var(--ink-900);
  }

  .chain__detail {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .chain__person {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    justify-self: start;
    margin-top: var(--sp-3);
    padding: 0.25rem 0.8rem 0.25rem 0.25rem;
    border: 1px solid rgb(255 255 255 / 0.95);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.65);
    box-shadow: 0 1px 2px rgb(28 51 148 / 0.08);
    color: var(--ink-800);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .chain__person:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }

  .chain__person img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    background: linear-gradient(160deg, #e6ecf8, #cfd9f0);
    mix-blend-mode: multiply;
  }

  @media (max-width: 900px) {
    .chain {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
      padding-left: var(--sp-6);
    }

    .chain::before,
    .chain::after {
      top: 0;
      bottom: 0;
      left: 9px;
      right: auto;
      width: 2px;
      height: auto;
    }

    .chain::before {
      background: repeating-linear-gradient(180deg, var(--border-strong) 0 6px, transparent 6px 12px);
    }

    .chain::after {
      transform: scaleY(0);
      transform-origin: top;
    }

    .chain.is-visible::after {
      transform: scaleY(1);
    }

    .chain__stage {
      padding-top: 0;
    }

    .chain__node {
      left: calc(-1 * var(--sp-6));
    }
  }

  /* ---------- Achievements bento ---------- */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: var(--sp-4);
    list-style: none;
  }

  .bento__tile {
    position: relative;
    display: grid;
    align-content: end;
    gap: var(--sp-1);
    min-height: 180px;
    padding: var(--sp-6);
    border: 1px solid var(--glass-border);
    border-radius: 22px;
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
    overflow: hidden;
  }

  .bento__tile--hero {
    grid-column: span 2;
    grid-row: span 2;
    padding-top: 4.5rem;
    border-color: transparent;
    background:
      radial-gradient(420px 280px at 90% 0%, rgb(255 255 255 / 0.22), transparent 70%),
      var(--gradient-brand);
    color: var(--white);
    box-shadow: 0 30px 60px -30px rgb(28 51 148 / 0.7);
  }

  .bento__tile--hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px) 0 0 / 32px 32px;
