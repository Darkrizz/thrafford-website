---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import BioVisual from '../components/BioVisual.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Stat from '../components/Stat.astro';
import PillarCard from '../components/PillarCard.astro';
import PartnerWall from '../components/PartnerWall.astro';
import CTABand from '../components/CTABand.astro';
import { accessGap, achievements } from '../data/site';
import ProcessRail from '../components/ProcessRail.astro';
import { pillars, pocmapAdvantages, amlNeed, ticobi } from '../data/technology';
import { team } from '../data/team';
import { partnerSectors, partnerTotal } from '../data/partners';
import { memberSlug } from '../utils/slug';
import type { IconName } from '../components/Icon.astro';

// Hero shortcuts into the three pillars, the pipeline, our collaborators and the quantum AI project.
const shortcuts: { title: string; body: string; href: string; icon: IconName }[] = [
  ...pillars.map((p) => ({ title: p.title, body: p.metric, href: `/technology/#${p.id}`, icon: p.icon })),
  { title: 'Product pipeline', body: 'AML, glioblastoma, lymphoma', href: '/technology/#pipeline', icon: 'flask' },
  { title: 'Collaborations', body: `${partnerTotal} partners across ${partnerSectors.length} sectors`, href: '#collaborations', icon: 'users' },
  { title: 'Conventional vs Quantum AI', body: 'Our human data map', href: '/technology/#quantum-ai', icon: 'atom' },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title">
          <span class="hero__accent">Immune cell therapy</span> made accessible.
        </h1>
        <p class="hero__lead">
          Thrafford is building India’s first affordable, off-the-shelf γδ T-cell therapy platform. Our lead programme
          targets measurable residual disease in acute myeloid leukaemia, the reservoir that relapse grows from.
        </p>
        <div class="hero__actions">
          <Button href="/technology/" size="lg" icon="arrow-right">Explore our technology</Button>
          <Button href="/contact/" size="lg" variant="outline-light">Partner with us</Button>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__image bezel">
          <BioVisual
            variant="hero"
            label="Animated schematic: a γδ T cell recognises a leukaemic cell through its γδ T-cell receptor and NKG2D, releases perforin and granzyme, and the leukaemic cell breaks apart into apoptotic bodies"
          />
        </div>
        <div class="hero__float hero__float--a">
          <span class="hero__float-icon"><Icon name="layers" size={20} /></span>
          <div><strong>Up to 15 doses</strong><span>from one healthy donor</span></div>
        </div>
        <div class="hero__float hero__float--b">
          <span class="hero__float-icon"><Icon name="dna" size={20} /></span>
          <div><strong>No gene editing</strong><span>no viral vectors</span></div>
        </div>
      </div>
    </div>

    <nav class="container hero__tiles" aria-label="Explore Thrafford">
      <ul>
        {
          shortcuts.map((t) => (
            <li>
              <a class="tile" href={t.href}>
                <span class="tile__icon">
                  <Icon name={t.icon} size={20} />
                </span>
                <span class="tile__text">
                  <strong>{t.title}</strong>
                  <span>{t.body}</span>
                </span>
                <Icon name="arrow-up-right" size={16} class="tile__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <!-- The problem -->
  <section class="section" id="problem" aria-labelledby="gap-title">
    <div class="container">
      <div class="gap__intro">
        <SectionHeading
          id="gap-title"
          eyebrow="The problem"
          title="The current therapies debulk the tumour burden but fail to eradicate measurable residual disease; this is the driving force of relapse."
        />
        <p class="gap__text" data-reveal>
          Induction chemotherapy can bring acute myeloid leukaemia (AML) into remission, with fewer than 5% blasts left
          in the marrow. The cells that survive sit below what a microscope can resolve and show up only on flow
          cytometry, qPCR or sequencing. This measurable residual disease (MRD) is one of the strongest predictors of
          relapse, and once AML relapses, survival is poor and a transplant is costly and out of reach for many patients.
        </p>
      </div>

      <div class="gap__grid">
        <div class="gap__figure bezel" data-reveal>
          <BioVisual
            variant="mrd"
            label="Graph of leukaemic burden over time: treatment pushes disease below the microscopy limit, residual disease hides there and relapses, unless γδ T cells given in the intervention window drive it to MRD-negative"
          />
        </div>
        <div class="gap__stats">
          {amlNeed.map((s) => <Stat value={s.value} prefix={s.prefix} display={s.display} label={s.label} />)}
        </div>
      </div>

      <p class="bridge" data-reveal>
        There are currently no approved therapies that target MRD, and advanced technologies such as cell and gene
        therapies remain inaccessible to the majority of patients.
      </p>

      <div class="context" data-reveal>
        <h3 class="context__title">The wider access gap in cell therapy</h3>
        <dl class="context__list">
          {
            accessGap.map((s) => (
              <div>
                <dt>{s.display ?? `${s.prefix ?? ''}${s.value.toLocaleString('en-US')}`}</dt>
                <dd>{s.label.split(/(\S+-\S+)/).map((t, i) => (i % 2 ? <span class="nowrap">{t}</span> : t))}</dd>
              </div>
            ))
          }
          <div>
            <dt>₹30–50 L</dt>
            <dd>per patient for autologous <span class="nowrap">CAR-T</span></dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- The solution -->
  <section class="section section--alt solution" aria-labelledby="solution-title">
    <div class="container">
      <div class="solution__grid">
        <div>
          <SectionHeading
            id="solution-title"
            eyebrow="Thrafford’s Solution"
            eyebrowAccent="Thrafford’s"
            title="TiCoBi: off-the-shelf γδ T cells from a single donor"
            lead={ticobi.summary}
          >
            <ul class="solution__chips" aria-label="TiCoBi characteristics">
              {ticobi.attributes.slice(0, 4).map((a) => (
                <li>
                  <Icon name="check" size={14} />
                  {a}
                </li>
              ))}
            </ul>
            <div>
              <Button href="/technology/#ticobi" icon="arrow-right">How TiCoBi works</Button>
            </div>
          </SectionHeading>
        </div>
        <div class="solution__figure bezel" data-reveal>
          <BioVisual
            variant="ticobi"
            label="Schematic: blood from one healthy donor passes through a time-controlled expansion chamber and yields up to fifteen off-the-shelf γδ T-cell doses"
          />
        </div>
      </div>
      <div class="solution__rail">
        <ProcessRail steps={ticobi.steps} compact label="How TiCoBi works" />
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section" aria-labelledby="approach-title">
    <div class="container">
      <SectionHeading
        id="approach-title"
        eyebrow="Our approach"
        title="Three pillars to close the gap"
        lead="We are rebuilding how cell therapy is manufactured, so treatments become affordable, scalable and accessible."
      />
      <div class="pillars">
        {pillars.map((p, i) => <PillarCard pillar={p} index={i} href={`/technology/#${p.id}`} />)}
      </div>
    </div>
  </section>

  <!-- PoCMAP -->
  <section class="section section--dark pocmap" aria-labelledby="pocmap-title">
    <div class="container pocmap__grid">
      <div class="pocmap__copy">
        <SectionHeading
          id="pocmap-title"
          eyebrow="The PoCMAP advantage"
          title="Manufacturing that happens where patients are treated"
          lead="PoCMAP moves cell therapy production out of distant centralised facilities and into the hospital."
        >
          <div>
            <Button href="/technology/" variant="light" icon="arrow-right">See the platform</Button>
          </div>
        </SectionHeading>
      </div>
      <ul class="pocmap__list">
        {
          pocmapAdvantages.map((a) => (
            <li data-reveal>
              <span class="pocmap__icon">
                <Icon name={a.icon} size={22} />
              </span>
              <div>
                <h3>{a.title}</h3>
                <p>{a.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Collaborations -->
  <section class="section" id="collaborations" aria-labelledby="partners-title">
    <div class="container">
      <SectionHeading
        id="partners-title"
        eyebrow="Our collaborations"
        title="Partners at the bench and the bedside"
        lead="Hospitals, academic labs, public research bodies and diagnostics companies work with us on γδ T-cell therapy, and each brings expertise a young company can’t build on its own."
        align="center"
      />
      <PartnerWall />
    </div>
  </section>

  <!-- Leadership -->
  <section class="section section--alt" aria-labelledby="team-title">
    <div class="container">
      <div class="leaders__head">
        <SectionHeading
          id="team-title"
          eyebrow="Leadership"
          title="Decades of drug discovery and GMP manufacturing experience"
        />
        <div data-reveal>
          <Button href="/team/" icon="arrow-right">Meet the team</Button>
        </div>
      </div>

      <div class="leaders">
        {
          team.map((m) => (
            <a class="leader" href={`/team/?member=${memberSlug(m.name)}`} aria-label={`${m.name} — view profile on the team page`} data-reveal>
              <span class="leader__photo"><img src={m.photo} alt="" width="600" height="560" loading="lazy" decoding="async" /></span>
              <div>
                <h3>{m.name}</h3>
                <p class="leader__role">{m.role}</p>
                <p class="leader__creds">{(m.credentials ?? []).map((c) => c.value.split(',')[0]).join(' · ')}</p>
              </div>
            </a>
          ))
        }
      </div>

      <ul class="achievements" aria-label="Collective achievements">
        {
          achievements.map((a) => (
            <li data-reveal>
              <span class="achievements__value">
                {a.prefix}
                <span data-count={a.value}>{a.value}</span>
                {a.suffix}
              </span>
              <span class="achievements__label">{a.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
    background: var(--ink-950);
    color: var(--ink-100);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(700px 420px at 85% 20%, rgb(53 87 222 / 0.22), transparent 70%),
      radial-gradient(520px 380px at 60% 110%, rgb(18 158 150 / 0.16), transparent 70%),
      var(--gradient-dark);
  }

  .hero__glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse at 30% 40%, black, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 30% 40%, black, transparent 75%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(2.5rem, 1rem + 5vw, 5rem);
  }

  .hero__copy {
    display: grid;
    gap: var(--sp-5);
  }

  .hero .eyebrow {
    color: var(--white);
  }

  .hero h1 {
    font-size: var(--fs-display);
    font-weight: var(--fw-heading);
    letter-spacing: var(--ls-heading);
    line-height: 1.06;
    color: var(--white);
  }

  .hero__accent {
    background: linear-gradient(100deg, #7fb0ff, var(--teal-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__lead {
    max-width: 52ch;
    font-size: var(--fs-lg);
    color: var(--ink-200);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }


  .hero__visual {
    position: relative;
    padding: var(--sp-5) 0;
  }

  .hero__image {
    margin: 0;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 750 / 620;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 40px 80px -30px rgb(0 0 0 / 0.7);
    animation: hero-in 1100ms var(--ease) both;
  }

  .hero__float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: 0.8rem 1.1rem 0.8rem 0.8rem;
    border-radius: 16px;
    background: color-mix(in srgb, var(--canvas) 93%, transparent);
    color: var(--ink-900);
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.55);
    animation: float-in 900ms var(--ease) both;
  }

  .hero__float div {
    display: grid;
    line-height: 1.2;
  }

  .hero__float strong {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 600;
  }

  .hero__float span:not(.hero__float-icon) {
    font-size: var(--fs-sm);
    color: var(--ink-700);
  }

  .hero__float-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--gradient-brand);
    color: var(--white);
  }

  .hero__float--a {
    left: -28px;
    bottom: -2%;
    animation-delay: 500ms;
  }

  .hero__float--b {
    right: -16px;
    top: 4%;
    animation-delay: 700ms;
  }

  /* Shortcut tiles along the foot of the hero */
  .hero__tiles {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .hero__tiles ul {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--sp-3);
    list-style: none;
  }

  .tile {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-4);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 16px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.02));
    color: var(--white);
    text-decoration: none;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: float-in 900ms var(--ease) both;
    animation-delay: 900ms;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .tile:hover {
    color: var(--white);
    border-color: rgb(99 210 202 / 0.45);
    background-color: rgb(255 255 255 / 0.05);
    transform: translateY(-3px);
  }

  .tile__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, rgb(69 101 230 / 0.35), rgb(18 158 150 / 0.3));
    color: var(--teal-300);
  }

  .tile__text {
    display: grid;
    gap: 0.2rem;
    padding-right: var(--sp-3);
  }

  .tile__text strong {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 600;
    line-height: 1.25;
  }

  .tile__text span {
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--ink-200);
  }

  .tile :global(.tile__arrow) {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    color: var(--ink-200);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .tile:hover :global(.tile__arrow) {
    color: var(--teal-300);
    transform: translate(2px, -2px);
  }

  @media (max-width: 1100px) {
    .hero__tiles ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hero__tiles ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile {
      padding: var(--sp-3);
    }

    .tile :global(.tile__arrow) {
      top: var(--sp-3);
      right: var(--sp-3);
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  @keyframes float-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
  }

  @media (max-width: 960px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      max-width: 560px;
    }

    .hero__float--a {
      left: 12px;
    }

    .hero__float--b {
      right: 12px;
    }
  }

  @media (max-width: 520px) {
    .hero__actions :global(.btn) {
      flex: 1 1 100%;
    }

    .hero__float {
      padding: 0.6rem 0.9rem 0.6rem 0.6rem;
    }

    .hero__float-icon {
      width: 34px;
      height: 34px;
    }

    .hero__float--b {
      top: -3%;
    }

    .hero__float--a {
      bottom: -4%;
    }

    .hero__float strong {
      font-size: 1rem;
    }
  }

  /* ---------- The problem ---------- */
  .gap__intro {
    display: grid;
    gap: var(--sp-5);
    margin-bottom: var(--sp-7);
    --heading-max: 1100px;
  }

  .gap__intro :global(.section-heading) {
    margin-bottom: 0;
  }

  .gap__text {
    max-width: 70ch;
    color: var(--ink-700);
    font-size: var(--fs-lg);
    line-height: 1.7;
  }

  .gap__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .gap__figure {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 750 / 520;
  }

  /* Four figures in a ruled 2 x 2 grid, all set in ink. */
  .gap__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gap__stats > :global(*) {
    padding: var(--sp-5) var(--sp-5) var(--sp-5) 0;
    border-bottom: 1px solid var(--border);
  }

  .gap__stats > :global(*:nth-child(even)) {
    padding-left: var(--sp-5);
    border-left: 1px solid var(--border);
  }

  .gap__stats > :global(*:nth-last-child(-n + 2)) {
    border-bottom: 0;
  }

  /* One line that carries the reader from the disease to the access gap. */
  .bridge {
    position: relative;
    max-width: 46ch;
    margin: clamp(3.5rem, 2.5rem + 3vw, 5.5rem) auto 0;
    padding-top: clamp(3rem, 2.5rem + 2vw, 4rem);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--ink-900);
  }

  .bridge::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, var(--blue-500), var(--teal-500));
    transform: translateX(-50%);
  }

  @media (max-width: 960px) {
    .gap__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .gap__stats {
      grid-template-columns: 1fr;
    }

    .gap__stats > :global(*),
    .gap__stats > :global(*:nth-child(even)) {
      padding-left: 0;
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }

    .gap__stats > :global(*:last-child) {
      border-bottom: 0;
    }
  }

  /* Wider CAR-T access context */
  .context {
    display: grid;
    gap: var(--sp-4);
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding: var(--sp-5) var(--sp-6);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .context__title {
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--ink-900);
  }

  .context__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--sp-4);
    margin: 0;
  }

  .context__list dt {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: var(--fw-heading);
    letter-spacing: var(--ls-heading);
    color: var(--ink-900);
  }

  .context__list dd {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-700);
    line-height: 1.4;
  }

  @media (max-width: 960px) {
    .context__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .context__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Solution ---------- */
  .solution__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .solution__grid :global(.section-heading) {
    margin-bottom: 0;
  }

  .solution__figure {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 750 / 520;
    box-shadow: var(--shadow-lg);
  }

  .solution__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
  }

  .solution__chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: var(--radius-pill);
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .solution__chips li :global(svg) {
    color: var(--teal-700);
  }

  .solution__rail {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding: var(--sp-6);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  @media (max-width: 960px) {
    .solution__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Pillars ---------- */
  .pillars {
    display: grid;
