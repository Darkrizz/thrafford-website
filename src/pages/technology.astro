---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import BioVisual from '../components/BioVisual.astro';
import CTABand from '../components/CTABand.astro';
import ProcessRail from '../components/ProcessRail.astro';
import {
  pillars,
  pocmapAdvantages,
  applications,
  oneLiner,
  ticobi,
  mechanism,
  pipeline,
  patents,
  quantumAI,
} from '../data/technology';

// Chapter index shown at the foot of the hero, in page order.
const chapters = [
  { id: 'ticobi', label: 'TiCoBi platform' },
  { id: 'why', label: 'Why γδ T cells' },
  { id: 'applications', label: 'Applications' },
  { id: 'pipeline', label: 'Product portfolio' },
  { id: 'point-of-care', label: 'PoCMAP' },
  { id: 'principles', label: 'Three pillars' },
  { id: 'patents', label: 'Patents' },
  { id: 'quantum-ai', label: 'Quantum AI' },
];

// Platform read-outs for the hero spec panel (all from the technology brief).
const specs = [
  { k: 'Cell type', v: 'γδ T cells · Vγ9Vδ2' },
  { k: 'Source', v: 'One healthy donor' },
  { k: 'Output', v: 'Up to 15 doses' },
  { k: 'Gene editing', v: 'None' },
  { k: 'Viral vectors', v: 'None' },
  { k: 'IP', v: '3 patents filed' },
];

// Time-controlled expansion curve (logistic) for the spec panel chart.
const curve = Array.from({ length: 61 }, (_, i) => {
  const x = 12 + i * 5.6;
  const y = 116 - 92 / (1 + Math.exp(-(x - 180) / 30));
  return `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`;
}).join('');
const area = `${curve}L348,124L12,124Z`;
const checkpoints = [96, 180, 264];

---

<BaseLayout
  title="TiCoBi"
  description="TiCoBi, Thrafford’s patent-filed bioprocess for off-the-shelf γδ T-cell therapy: up to 15 doses from one donor, no gene editing, built to target MRD in AML."
>
  <section class="th" aria-labelledby="th-title">
    <div class="th__bg" aria-hidden="true"></div>
    <div class="container th__grid">
      <div class="th__copy">
        <p class="eyebrow">TiCoBi</p>
        <h1 id="th-title">
          One donor.<br /><span class="nowrap">Up to <span class="th__accent">fifteen</span> doses.</span>
        </h1>
        <p class="th__lead">{oneLiner}</p>
        <div class="th__actions">
          <Button href="#ticobi" size="lg" icon="arrow-right">Explore TiCoBi</Button>
          <Button href="#patents" size="lg" variant="outline-light">View our patents</Button>
        </div>
      </div>

      <aside class="spec" aria-label="TiCoBi platform specification">
        <header class="spec__head">
          <span class="spec__title">TiCoBi platform read-out</span>
          <span class="spec__status"><span class="spec__dot" aria-hidden="true"></span>Patent filed</span>
        </header>
        <figure class="spec__chart">
          <svg viewBox="0 0 360 140" aria-hidden="true">
            <defs>
              <linearGradient id="th-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#63d2ca" stop-opacity="0.35" />
                <stop offset="1" stop-color="#63d2ca" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="th-line" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#8fa6ff" />
                <stop offset="1" stop-color="#63d2ca" />
              </linearGradient>
            </defs>
            <g stroke="#ffffff" stroke-opacity="0.07">
              {[24, 52, 80, 108].map((y) => <line x1="12" x2="348" y1={y} y2={y} />)}
            </g>
            {
              checkpoints.map((x, i) => (
                <g class="spec__cp" style={`--i:${i}`}>
                  <line x1={x} x2={x} y1="16" y2="124" stroke="#63d2ca" stroke-opacity="0.35" stroke-dasharray="3 4" />
                  <text x={x} y="11" text-anchor="middle">T{i + 1}</text>
                </g>
              ))
            }
            <path d={area} fill="url(#th-area)" class="spec__area" />
            <path d={curve} fill="none" stroke="url(#th-line)" stroke-width="2.5" stroke-linecap="round" pathLength="1" class="spec__line" />
            <circle cx="348" cy="24.4" r="4" fill="#63d2ca" class="spec__end" />
            <line x1="12" x2="348" y1="124" y2="124" stroke="#ffffff" stroke-opacity="0.25" />
          </svg>
          <figcaption>
            <span>Day 0</span>
            <span>Controlled expansion</span>
            <span>Harvest, up to 15 doses</span>
          </figcaption>
        </figure>
        <dl class="spec__list">
          {
            specs.map((x) => (
              <div>
                <dt>{x.k}</dt>
                <dd>{x.v}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <nav class="container th__index" aria-label="On this page">
      <p class="th__index-title">Jump to a section</p>
      <ol>
        {
          chapters.map((c) => (
            <li>
              <a href={`#${c.id}`}>
                <span>{c.label}</span>
                <Icon name="arrow-right" size={16} class="th__index-arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <!-- TiCoBi -->
  <section class="section ticobi" id="ticobi" aria-labelledby="ticobi-title">
    <div class="container">
      <div class="ticobi__grid">
        <div class="ticobi__copy">
          <SectionHeading id="ticobi-title" eyebrow="The platform" lead={ticobi.summary}>
            <Fragment slot="title">
              <span class="grad">TiCoBi</span>: Proprietary <span class="grad">Ti</span>me-<span class="grad">Co</span>ntrolled <span class="grad">Bi</span>oprocess
            </Fragment>
          </SectionHeading>
          <ul class="chips" aria-label="TiCoBi characteristics" data-reveal>
            {
              ticobi.attributes.map((a) => (
                <li>
                  <Icon name="check" size={14} />
                  {a}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="ticobi__figure bezel" data-reveal>
          <BioVisual
            variant="ticobi"
            label="Schematic: blood from one healthy donor passes through a time-controlled expansion chamber and yields up to fifteen off-the-shelf γδ T-cell doses"
          />
        </div>
      </div>
      <div class="ticobi__rail">
        <ProcessRail steps={ticobi.steps} label="How TiCoBi works" />
      </div>
    </div>
  </section>

  <!-- Why γδ T cells -->
  <section class="section section--alt" id="why" aria-labelledby="why-title">
    <div class="container">
      <SectionHeading
        id="why-title"
        eyebrow="Immune cells that find leukaemia without a map"
        title="Why γδ T cells"
        lead="Immune-mediated elimination of leukaemia is most likely to work when disease burden is minimal — before overt relapse and an increasingly immunosuppressive microenvironment."
      />
      <div class="mech">
        <div class="mech__figure bezel" data-reveal>
          <BioVisual
            variant="hero"
            label="Animated schematic: a γδ T cell recognises a leukaemic cell through its γδ T-cell receptor and NKG2D, releases perforin and granzyme, and the leukaemic cell breaks apart into apoptotic bodies"
          />
        </div>
        <ul class="mech__list">
          {
            mechanism.map((m) => (
              <li class="mech__item" data-reveal>
                <span class="mech__icon">
                  <Icon name={m.icon} size={22} />
                </span>
                <div>
                  <h3>{m.title}</h3>
                  <p>{m.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Applications -->
  <section class="section section--dark apps" id="applications" aria-labelledby="apps-title">
    <div class="container apps__grid">
      <div>
        <SectionHeading
          id="apps-title"
          eyebrow="Applications"
          title="One platform, many cell therapies"
          lead="Our reagent-agnostic design reaches across oncology and autoimmune disease. Longer term, our AI and quantum computation initiative designs and optimises targets, algorithms and processes."
        />
        <ul class="apps__list">
          {
            applications.map((a) => (
              <li data-reveal>
                <span class="apps__icon">
                  <Icon name={a.icon} size={22} />
                </span>
                {a.title}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="apps__image bezel" data-reveal>
        <BioVisual variant="genome" label="Schematic of a DNA double helix with a highlighted gene-editing site" />
      </div>
    </div>
  </section>

  <!-- Product portfolio -->
  <section class="section" id="pipeline" aria-labelledby="pipeline-title">
    <div class="container">
      <SectionHeading
        id="pipeline-title"
        eyebrow="Product portfolio"
        title="One platform, a growing pipeline"
        align="center"
        lead="TiCoBi is antigen-agnostic. Beyond AML, the same process extends to glioblastoma and other solid tumours — and TiCoBi-generated γδ T cells can also supply partners’ CAR-T programmes."
      />
      <div class="pipeline" role="table" aria-label="Product portfolio" data-reveal>
        <div class="pipeline__head" role="row">
          <span role="columnheader">Programme</span>
          <span role="columnheader">Indication</span>
          <span role="columnheader">Modality</span>
        </div>
        {
          pipeline.map((p) => (
            <div class:list={['prog', { 'prog--lead': p.lead }]} role="row">
              <div class="prog__id" role="cell">
                <span class="prog__code">{p.code}</span>
              </div>
              <div class="prog__main" role="cell">
                <h3>{p.indication}</h3>
                {p.lead && (
                  <span class="prog__badge">
                    <span class="prog__pulse" aria-hidden="true" />
                    Lead programme
                  </span>
                )}
              </div>
              <div class="prog__modality" role="cell">
                <strong>{p.modality}</strong>
                <span class="prog__platform">{p.platform}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Connecting line: why point-of-care matters -->
  <div class="connector" data-reveal>
    <p class="container">
      In low- and middle-income countries, including India, accessibility remains a major challenge, which is why
      adopting PoCMAP can be a revolutionary intervention.
    </p>
  </div>

  <!-- PoCMAP -->
  <section class="section pocmap" id="point-of-care" aria-labelledby="compare-title">
    <div class="container">
      <SectionHeading
        id="compare-title"
        eyebrow="Point-of-care with PoCMAP"
        title="Shorter journeys from cell to patient"
        lead="In conventional manufacturing, a patient’s cells are collected at the hospital, frozen and shipped to a distant facility, then frozen again and shipped back for infusion. Decentralising manufacturing to the hospital removes both journeys, reducing logistics and freeze–thaw cycles."
      />

      <figure class="unit" data-reveal aria-labelledby="unit-cap">
        <figcaption id="unit-cap" class="unit__cap">
          <strong>Point-of-care with PoCMAP</strong>
          <span>A PoCMAP unit inside the treating hospital</span>
        </figcaption>

        <div class="unit__site">
          <span class="unit__site-label">
            <Icon name="hospital" size={16} /> Hospital <span class="unit__pin">1</span>
          </span>

          <div class="unit__line">
            <div class="unit__stage">
              <span class="unit__stage-icon"><Icon name="user" size={20} /></span>
              <strong>Cells collected</strong>
              <span>On site, from the patient or donor</span>
            </div>

            <span class="unit__arrow" aria-hidden="true"></span>

            <div class="unit__stage unit__stage--bays">
              <strong>Manufactured on-site with PoCMAP <span class="unit__pin">2</span></strong>
              <ul class="unit__bays">
                <li><span>CAR-T</span><i style="--w: 78%"></i></li>
                <li><span>NK</span><i style="--w: 52%"></i></li>
                <li><span>Dendritic</span><i style="--w: 64%"></i></li>
              </ul>
              <span class="unit__note">Same platform, different cell systems <span class="unit__pin">3</span></span>
            </div>

            <span class="unit__arrow" aria-hidden="true"></span>

            <div class="unit__stage">
              <span class="unit__stage-icon unit__stage-icon--teal"><Icon name="shield" size={20} /></span>
              <strong>In-line QC <span class="unit__pin">4</span></strong>
              <span>Real-time sterility &amp; quality checks</span>
            </div>

            <span class="unit__arrow" aria-hidden="true"></span>

            <div class="unit__stage">
              <span class="unit__stage-icon"><Icon name="hospital" size={20} /></span>
              <strong>Treated</strong>
              <span>In the same hospital</span>
            </div>
          </div>

          <p class="unit__journey">
            <span class="unit__pin">5</span>
            Cell to patient without leaving the building: no inter-site shipping and fewer freeze–thaw cycles.
          </p>
        </div>

        <h3 class="unit__subtitle">A modular platform built for hospitals</h3>
        <ol class="adv">
          {
            pocmapAdvantages.map((a, i) => (
              <li class="adv__item">
                <span class="unit__pin unit__pin--lg">{i + 1}</span>
                <h4>{a.title}</h4>
                <p>{a.body}</p>
              </li>
            ))
          }
        </ol>
      </figure>
    </div>
  </section>

  <!-- Three pillars -->
  <section class="section section--alt" id="principles" aria-labelledby="pillars-title">
    <div class="container">
      <SectionHeading id="pillars-title" eyebrow="Platform principles" title="Our three-pillar approach">
        <p class="pillars-kicker" aria-label="Affordable, scalable, accessible">
          <span>Affordable.</span> <span>Scalable.</span> <span>Accessible.</span>
        </p>
      </SectionHeading>

      <div class="rows">
        {
          pillars.map((p, i) => (
            <article class:list={['row', { 'row--flip': i % 2 === 1 }]} id={p.id} aria-labelledby={`${p.id}-title`}>
              <div class="row__media bezel" data-reveal>
                <BioVisual variant={p.visual} label={p.visualLabel} />
              </div>
              <div class="row__copy" data-reveal>
                <h3 id={`${p.id}-title`}>{p.title}</h3>
                <p class="row__metric">{p.metric}</p>
                <p class="row__body">{p.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Intellectual property -->
  <section class="section ip" id="patents" aria-labelledby="ip-title">
    <div class="container">
      <SectionHeading
        id="ip-title"
        eyebrow="Intellectual property"
        title="Protected by design"
        lead="Our moat combines patent-filed manufacturing with trade-secret process logic — an integrated value chain that takes years of validation to rebuild."
      />
      <ol class="patents">
        {
          patents.map((p) => (
            <li class="patent" data-reveal>
              <span class="patent__status">
                <span class="patent__dot" aria-hidden="true" />
                Patent filed
              </span>
              <p class="patent__label">Application no.</p>
              <p class="patent__no" aria-label="Application number, partly hidden">{p.number}</p>
              <h3>{p.title}</h3>
            </li>
          ))
        }
      </ol>
      <p class="ip__more" data-reveal>
        <a href="/publications/#patent">See the team’s full patent record <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- Ongoing project: conventional vs quantum AI -->
  <section class="section section--alt quantum" id="quantum-ai" aria-labelledby="quantum-title">
    <div class="container">
      <SectionHeading
        id="quantum-title"
        eyebrow="Ongoing project"
        title="Conventional vs Quantum AI"
        lead={quantumAI.aim}
        align="center"
      />

      <div class="versus" data-reveal>
        <div class="versus__col versus__col--classic">
          <p class="versus__name">Conventional AI</p>
          <dl>
            {
              quantumAI.contrast.map((c) => (
                <div>
                  <dt>{c.topic}</dt>
                  <dd>{c.conventional}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <span class="versus__vs" aria-hidden="true">vs</span>

        <div class="versus__col versus__col--quantum">
          <svg class="versus__orb" viewBox="0 0 160 160" aria-hidden="true">
            <defs>
              <linearGradient id="orb-line" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#8fa6ff" />
                <stop offset="1" stop-color="#63d2ca" />
              </linearGradient>
            </defs>
            <circle cx="80" cy="80" r="62" fill="none" stroke="url(#orb-line)" stroke-opacity="0.6" />
            <ellipse cx="80" cy="80" rx="62" ry="18" fill="none" stroke="#8fa6ff" stroke-opacity="0.35" />
            <ellipse cx="80" cy="80" rx="18" ry="62" fill="none" stroke="#8fa6ff" stroke-opacity="0.2" />
            <path d="M80 14v132M14 80h132" stroke="#ffffff" stroke-opacity="0.12" stroke-dasharray="2 4" />
            <g class="versus__state">
              <path d="M80 80 L118 38" stroke="#63d2ca" stroke-width="2.5" stroke-linecap="round" />
              <circle cx="118" cy="38" r="5" fill="#63d2ca" />
            </g>
            <circle cx="80" cy="80" r="3.5" fill="#ffffff" />
          </svg>
          <p class="versus__name">Quantum AI</p>
          <dl>
            {
              quantumAI.contrast.map((c) => (
                <div>
                  <dt>{c.topic}</dt>
                  <dd>{c.quantum}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <h3 class="uses__title" data-reveal>Where the map will be used</h3>
      <ul class="uses">
        {
          quantumAI.uses.map((u) => (
            <li class="use" data-reveal>
              <span class="use__icon">
                <Icon name={u.icon} size={22} />
              </span>
              <h4>{u.title}</h4>
              <p>{u.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTABand
    title="Partner with us on TiCoBi"
    body="Talk to us about clinical partnerships, our γδ T-cell programmes, or supplying γδ T cells for your CAR-T pipeline."
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .th {
    position: relative;
    padding-top: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    background: var(--ink-950);
    color: var(--ink-100);
    overflow: hidden;
    isolation: isolate;
  }

  .th__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(760px 460px at 82% 18%, rgb(53 87 222 / 0.26), transparent 70%),
      radial-gradient(620px 420px at 8% 100%, rgb(18 158 150 / 0.18), transparent 70%),
      var(--gradient-dark);
  }

  .th__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000, transparent 75%);
  }

  .th__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
  }

  .th__copy {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }

  .th .eyebrow {
    color: var(--white);
  }

  .th h1 {
    font-size: var(--fs-display);
    font-weight: var(--fw-heading);
    line-height: 1.04;
    letter-spacing: var(--ls-heading);
    color: var(--white);
  }

  @media (max-width: 480px) {
    .th h1 .nowrap {
      white-space: normal;
    }
  }

  .th__accent {
    background: linear-gradient(90deg, #8fa6ff, #63d2ca);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .th__lead {
    max-width: 54ch;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--ink-200);
  }

  .th__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }

  /* Spec panel: an instrument read-out */
  .spec {
    position: relative;
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-6);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 22px;
    background: linear-gradient(160deg, rgb(28 39 52 / 0.92), rgb(12 17 24 / 0.96));
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.03),
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 40px 80px -30px rgb(0 0 0 / 0.7);
    animation: th-in 1100ms var(--ease) both;
  }

  @keyframes th-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  .spec__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .spec__title {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--white);
  }

  .spec__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgb(95 212 207 / 0.35);
    border-radius: var(--radius-pill);
    background: rgb(95 212 207 / 0.1);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--teal-300);
    white-space: nowrap;
  }

  .spec__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-300);
    animation: th-blink 1.8s ease-in-out infinite;
  }

  @keyframes th-blink {
    50% {
      opacity: 0.25;
    }
  }

  .spec__chart {
    margin: 0;
    padding: var(--sp-4);
    border: 1px solid rgb(255 255 255 / 0.07);
    border-radius: 14px;
    background: rgb(0 0 0 / 0.22);
  }

  .spec__chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .spec__cp text {
    fill: var(--teal-300);
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: 600;
  }

  .spec__cp {
    opacity: 0;
    animation: th-fade 600ms var(--ease) forwards;
    animation-delay: calc(0.9s + var(--i) * 0.35s);
  }

  .spec__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: th-draw 2.2s var(--ease) 0.5s forwards;
  }

  .spec__area {
    opacity: 0;
    animation: th-fade 1.2s var(--ease) 1.6s forwards;
  }

  .spec__end {
    opacity: 0;
    animation:
      th-fade 400ms var(--ease) 2.5s forwards,
      th-blink 1.8s ease-in-out 3s infinite;
  }

  @keyframes th-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes th-fade {
    to {
      opacity: 1;
    }
  }

  .spec figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--ink-200);
  }

  .spec__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .spec__list > div {
    display: grid;
    gap: 0.15rem;
    padding: var(--sp-3) 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .spec__list > div:nth-child(odd) {
    padding-right: var(--sp-4);
  }

  .spec__list > div:nth-child(even) {
    padding-left: var(--sp-4);
    border-left: 1px solid rgb(255 255 255 / 0.08);
  }

  .spec__list > div:nth-last-child(-n + 2) {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .spec dt {
    font-size: var(--fs-sm);
    color: var(--ink-200);
  }

  .spec dd {
    margin: 0;
    font-weight: 600;
    color: var(--white);
  }

  /* Chapter index: eight glass buttons that jump down the page */
  .th__index {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .th__index-title {
    margin-bottom: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--white);
  }

  .th__index ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-3);
    list-style: none;
  }

  .th__index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    height: 100%;
    min-height: 56px;
    padding: 0.85rem 1rem 0.85rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 14px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .th__index a :global(.th__index-arrow) {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    padding: 7px;
    border-radius: 50%;
    background: rgb(143 166 255 / 0.16);
    color: var(--teal-300);
    transform: rotate(90deg);
    transition:
      background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .th__index a:hover {
    color: var(--white);
    border-color: rgb(99 210 202 / 0.55);
    background-color: rgb(255 255 255 / 0.06);
    transform: translateY(-2px);
  }

  .th__index a:hover :global(.th__index-arrow) {
    background: var(--gradient-brand);
    color: var(--white);
    transform: rotate(90deg) translateX(2px);
  }

  @media (max-width: 1000px) {
    .th__grid {
      grid-template-columns: 1fr;
    }

    .th__index ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .spec {
      padding: var(--sp-5) var(--sp-4);
    }

    .spec__list {
      grid-template-columns: 1fr;
    }

    .spec__list > div:nth-child(n) {
      padding-inline: 0;
      border-left: 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }

    .spec__list > div:last-child {
      border-bottom: 0;
    }

    .th__index ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* TiCoBi */
  .ticobi {
    scroll-margin-top: var(--header-h);
  }

  .ticobi__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .ticobi__copy :global(.section-heading) {
    margin-bottom: var(--sp-6);
  }

  /* Brand gradient on "TiCoBi" and on the letters that spell it out. */
  .grad {
    background: linear-gradient(120deg, var(--blue-600), var(--blue-500) 55%, var(--teal-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ticobi__figure {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 750 / 520;
    box-shadow: var(--shadow-lg);
  }

  .ticobi__rail {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: var(--radius-pill);
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .chips li :global(svg) {
    color: var(--teal-700);
  }

  @media (max-width: 960px) {
    .ticobi__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Why γδ T cells */
  .mech {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .mech__figure {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 750 / 620;
    box-shadow: var(--shadow-lg);
  }

  .mech__list {
    display: grid;
    gap: var(--sp-4);
    list-style: none;
  }

  .mech__item {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-5);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .mech__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--gradient-brand);
    color: var(--white);
  }

  .mech__item h3 {
    font-size: var(--fs-lg);
    margin-bottom: var(--sp-1);
  }

  .mech__item p {
    color: var(--text-muted);
  }

  @media (max-width: 960px) {
    .mech {
      grid-template-columns: 1fr;
    }
  }

  /* Product portfolio */
  .pipeline {
    --cols: minmax(0, 1fr) minmax(0, 1.3fr) minmax(0, 1.1fr);
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .pipeline__head,
  .prog {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--sp-6);
    padding-inline: clamp(1.25rem, 0.5rem + 2vw, 2.25rem);
  }

  .pipeline__head {
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--border);
    background: rgb(255 255 255 / 0.45);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-700);
  }

  .prog {
    position: relative;
    align-items: center;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    transition: background-color var(--dur) var(--ease);
  }

  .prog + .prog {
    border-top: 1px solid var(--border);
  }

  .prog:hover {
    background-color: rgb(255 255 255 / 0.5);
  }

  /* Lead programme: the same row, lifted by a faint brand wash and an edge rule. */
  .prog--lead {
    background: linear-gradient(90deg, rgb(69 101 230 / 0.09), rgb(18 158 150 / 0.04) 60%, transparent);
  }

  .prog--lead::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--gradient-brand);
  }

  .prog__code {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--blue-600);
    font-variant-numeric: tabular-nums;
  }

  .prog__main {
    display: grid;
    justify-items: start;
    gap: var(--sp-2);
  }

  .prog__main h3 {
    font-size: var(--fs-xl);
    line-height: 1.2;
    color: var(--ink-900);
  }

  .prog__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid rgb(38 67 196 / 0.2);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.7);
    color: var(--blue-700);
    font-size: var(--fs-sm);
    font-weight: 600;
    white-space: nowrap;
  }

  .prog__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal-500);
    box-shadow: 0 0 0 0 rgb(18 158 150 / 0.5);
    animation: prog-pulse 2.4s var(--ease) infinite;
  }

  @keyframes prog-pulse {
    70%,
    100% {
      box-shadow: 0 0 0 7px rgb(18 158 150 / 0);
    }
  }

  .prog__modality {
    display: grid;
    gap: 0.2rem;
  }

  .prog__modality strong {
    font-weight: 600;
    color: var(--ink-900);
  }

  .prog__platform {
    font-size: var(--fs-sm);
    color: var(--ink-700);
  }

  @media (max-width: 900px) {
    .pipeline__head {
      display: none;
    }

    .prog {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }
  }

  /* Connecting line between the portfolio and PoCMAP: the two sections close in around it. */
  #pipeline {
    padding-bottom: var(--sp-6);
  }

  .pocmap {
    padding-top: var(--sp-6);
  }

  .connector {
    position: relative;
    padding-block: clamp(1rem, 0.5rem + 1vw, 1.5rem);
    text-align: center;
  }

  .connector::before,
  .connector::after {
    content: '';
    display: block;
    width: 2px;
    height: clamp(2.5rem, 2rem + 2vw, 4rem);
    margin-inline: auto;
    border-radius: 2px;
  }

  .connector::before {
    background: linear-gradient(180deg, transparent, var(--blue-500));
  }

  .connector::after {
    background: linear-gradient(180deg, var(--teal-500), transparent);
  }

  .connector p {
    max-width: 52ch;
    margin-block: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink-900);
  }

  /* Intellectual property */
  .ip {
    scroll-margin-top: var(--header-h);
  }

  .patents {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
    list-style: none;
  }

  .patent {
    position: relative;
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--sp-2);
    padding: var(--sp-6);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 100% 22px,
      linear-gradient(160deg, #141b23, #0a0e13);
    border: 1px solid rgb(143 166 255 / 0.22);
    color: var(--ink-100);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .patent::after {
    content: '';
    position: absolute;
    right: -60px;
    top: -60px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(69 101 230 / 0.35), transparent 70%);
    pointer-events: none;
  }

  .patent__status {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: var(--sp-4);
    padding: 0.2rem 0.7rem;
    border: 1px solid rgb(95 212 207 / 0.35);
    border-radius: var(--radius-pill);
    background: rgb(95 212 207 / 0.1);
    color: var(--teal-300);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .patent__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-300);
    box-shadow: 0 0 8px var(--teal-300);
  }

  .patent__label {
    font-size: var(--fs-sm);
    color: var(--ink-200);
  }

  .patent__no {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(90deg, #8fa6ff, #63d2ca);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .patent h3 {
    justify-self: stretch;
    margin-top: var(--sp-3);
    padding-top: var(--sp-4);
    border-top: 1px dashed rgb(255 255 255 / 0.14);
    font-size: var(--fs-lg);
    line-height: 1.35;
    color: var(--white);
  }

  .ip__more {
    margin-top: var(--sp-6);
  }

  .ip__more a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 600;
    color: var(--blue-600);
    text-decoration: none;
  }

  .ip__more a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 960px) {
    .patents {
      grid-template-columns: 1fr;
    }
  }

  .pillars-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5ch;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .pillars-kicker span {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Pillar rows */
  .rows {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .row--flip .row__media {
    order: 2;
  }

  .row__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ink-100);
  }

  .row__media {
    box-shadow: var(--shadow-lg);
  }

  .row__copy {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }

  .row h3 {
    font-size: var(--fs-2xl);
    letter-spacing: var(--ls-heading);
  }

  .row__metric {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--teal-700);
  }

  .row__body {
    max-width: 46ch;
    font-size: var(--fs-lg);
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
    }

    .row--flip .row__media {
      order: 0;
    }
  }

  /* PoCMAP: heading on one line on wide screens */
  @media (min-width: 1000px) {
    .pocmap :global(.section-heading__title) {
      max-width: none;
      white-space: nowrap;
    }
  }

  /* One dark panel: the hospital schematic above, the five advantages in a row beneath it. */
  .unit {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    margin: 0;
    padding: clamp(1.25rem, 0.5rem + 2.5vw, 2.75rem);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 24px;
    background:
      radial-gradient(640px 320px at 100% 0%, rgb(69 101 230 / 0.28), transparent 70%),
      radial-gradient(520px 300px at 0% 100%, rgb(18 158 150 / 0.2), transparent 70%),
      linear-gradient(160deg, #141b23, #0a0e13);
    color: var(--ink-100);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    isolation: isolate;
  }

  .unit__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    margin: 0;
  }

  .unit__cap strong {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .unit__cap span {
    font-size: var(--fs-sm);
    color: var(--ink-200);
  }

  /* The dashed boundary is the hospital: everything happens inside it. */
  .unit__site {
    position: relative;
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-7) var(--sp-5) var(--sp-5);
    border: 1.5px dashed rgb(143 166 255 / 0.35);
    border-radius: 18px;
    background:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 24px 24px;
  }

  .unit__site-label {
    position: absolute;
    top: -0.95rem;
    left: var(--sp-5);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.35rem 0.25rem 0.7rem;
    border: 1px solid rgb(143 166 255 / 0.35);
    border-radius: var(--radius-pill);
    background: #121922;
    color: var(--white);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .unit__pin {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--gradient-brand);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .unit__pin--lg {
    width: 30px;
    height: 30px;
    font-size: var(--fs-sm);
    box-shadow: 0 6px 14px -6px rgb(69 101 230 / 0.8);
  }

  .unit__line {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) 20px minmax(0, 1.5fr) 20px minmax(0, 0.95fr) 20px minmax(0, 0.8fr);
    align-items: stretch;
    gap: var(--sp-2);
  }

  .unit__stage {
    display: grid;
    justify-items: start;
    align-content: start;
    gap: 0.35rem;
    padding: var(--sp-4);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 14px;
    background: rgb(255 255 255 / 0.05);
  }

  .unit__stage strong {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 600;
    line-height: 1.25;
    color: var(--white);
  }

  .unit__stage > span:not(.unit__stage-icon) {
    font-size: var(--fs-sm);
    line-height: 1.4;
    color: var(--ink-200);
  }

  .unit__stage-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-bottom: 0.2rem;
    border-radius: 11px;
    background: rgb(143 166 255 / 0.14);
    color: var(--blue-300);
  }

  .unit__stage-icon--teal {
    background: rgb(99 210 202 / 0.14);
    color: var(--teal-300);
  }

  .unit__bays {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    margin: 0.35rem 0;
    list-style: none;
  }

  .unit__bays li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-100);
  }

  .unit__bays i {
    position: relative;
    height: 8px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.08);
  }

  .unit__bays i::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--blue-500), var(--teal-300));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.2s var(--ease) 0.3s;
  }

  .unit:global(.is-visible) .unit__bays i::after,
  :global(html:not(.js)) .unit__bays i::after {
    transform: scaleX(1);
  }

  .unit__note {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .unit__arrow {
    position: relative;
    align-self: center;
    height: 2px;
    background: linear-gradient(90deg, var(--blue-500), var(--teal-300));
  }

  .unit__arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 2px solid var(--teal-300);
    border-right: 2px solid var(--teal-300);
    transform: translateY(-50%) rotate(45deg);
  }

  .unit__journey {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
