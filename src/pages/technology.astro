---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import BioVisual from '../components/BioVisual.astro';
import CTABand from '../components/CTABand.astro';
import Stat from '../components/Stat.astro';
import ProcessRail from '../components/ProcessRail.astro';
import {
  pillars,
  pocmapAdvantages,
  applications,
  oneLiner,
  amlNeed,
  ticobi,
  mechanism,
  comparison,
  pipeline,
  patents,
  moat,
} from '../data/technology';

// Chapter index shown at the foot of the hero.
const chapters = [
  { id: 'need', label: 'The hidden disease' },
  { id: 'ticobi', label: 'TiCoBi platform' },
  { id: 'why', label: 'Why γδ T cells' },
  { id: 'pipeline', label: 'Pipeline' },
  { id: 'principles', label: 'Platform principles' },
  { id: 'point-of-care', label: 'Point-of-care' },
  { id: 'patents', label: 'Intellectual property' },
  { id: 'applications', label: 'Applications' },
];

// Platform read-outs for the hero spec panel (all from the technology brief).
const specs = [
  { k: 'Cell type', v: 'γδ T cells · Vγ9Vδ2' },
  { k: 'Source', v: 'One healthy donor' },
  { k: 'Output', v: 'Up to 15 doses' },
  { k: 'Gene editing', v: 'None' },
  { k: 'Viral vectors', v: 'None' },
  { k: 'IP', v: '3 patents filed' },
];

// Time-controlled expansion curve (logistic) for the spec panel chart.
const curve = Array.from({ length: 61 }, (_, i) => {
  const x = 12 + i * 5.6;
  const y = 116 - 92 / (1 + Math.exp(-(x - 180) / 30));
  return `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`;
}).join('');
const area = `${curve}L348,124L12,124Z`;
const checkpoints = [96, 180, 264];

const centralised = [
  { icon: 'user', label: 'Cells collected at hospital' },
  { icon: 'freeze', label: 'Frozen & shipped out' },
  { icon: 'truck', label: 'Manufactured at a distant facility' },
  { icon: 'freeze', label: 'Frozen & shipped back' },
  { icon: 'hospital', label: 'Infused at hospital' },
] as const;

const pointOfCare = [
  { icon: 'user', label: 'Cells collected' },
  { icon: 'layers', label: 'Manufactured on-site with PoCMAP' },
  { icon: 'shield', label: 'Real-time sterility & QC' },
  { icon: 'hospital', label: 'Treated in the same hospital' },
] as const;
---

<BaseLayout
  title="Technology & Software"
  description="TiCoBi, Thrafford’s patent-filed bioprocess for off-the-shelf γδ T-cell therapy: up to 15 doses from one donor, no gene editing, built to target MRD in AML."
>
  <section class="th" aria-labelledby="th-title">
    <div class="th__bg" aria-hidden="true"></div>
    <div class="container th__grid">
      <div class="th__copy">
        <p class="eyebrow">Technology &amp; Software</p>
        <h1 id="th-title">
          One donor.<br /><span class="nowrap">Up to <span class="th__accent">fifteen</span> doses.</span>
        </h1>
        <p class="th__lead">{oneLiner}</p>
        <div class="th__actions">
          <Button href="#ticobi" size="lg" icon="arrow-right">Explore TiCoBi</Button>
          <Button href="#patents" size="lg" variant="outline-light">View our patents</Button>
        </div>
      </div>

      <aside class="spec" aria-label="TiCoBi platform specification">
        <header class="spec__head">
          <span class="spec__title">TiCoBi · Platform read-out</span>
          <span class="spec__status"><span class="spec__dot" aria-hidden="true"></span>Patent filed</span>
        </header>
        <figure class="spec__chart">
          <svg viewBox="0 0 360 140" aria-hidden="true">
            <defs>
              <linearGradient id="th-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#63d2ca" stop-opacity="0.35" />
                <stop offset="1" stop-color="#63d2ca" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="th-line" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#8fa6ff" />
                <stop offset="1" stop-color="#63d2ca" />
              </linearGradient>
            </defs>
            <g stroke="#ffffff" stroke-opacity="0.07">
              {[24, 52, 80, 108].map((y) => <line x1="12" x2="348" y1={y} y2={y} />)}
            </g>
            {
              checkpoints.map((x, i) => (
                <g class="spec__cp" style={`--i:${i}`}>
                  <line x1={x} x2={x} y1="16" y2="124" stroke="#63d2ca" stroke-opacity="0.35" stroke-dasharray="3 4" />
                  <text x={x} y="12" text-anchor="middle">T{i + 1}</text>
                </g>
              ))
            }
            <path d={area} fill="url(#th-area)" class="spec__area" />
            <path d={curve} fill="none" stroke="url(#th-line)" stroke-width="2.5" stroke-linecap="round" pathLength="1" class="spec__line" />
            <circle cx="348" cy="24.4" r="4" fill="#63d2ca" class="spec__end" />
            <line x1="12" x2="348" y1="124" y2="124" stroke="#ffffff" stroke-opacity="0.25" />
          </svg>
          <figcaption>
            <span>Day 0</span>
            <span>Controlled expansion</span>
            <span>Harvest · ≤15 doses</span>
          </figcaption>
        </figure>
        <dl class="spec__list">
          {
            specs.map((x) => (
              <div>
                <dt>{x.k}</dt>
                <dd>{x.v}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <nav class="container th__index" aria-label="On this page">
      <ol>
        {
          chapters.map((c, i) => (
            <li>
              <a href={`#${c.id}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {c.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </section>

  <!-- The unmet need -->
  <section class="section section--dark need" id="need" aria-labelledby="need-title" style="--heading-max: 1040px">
    <div class="container">
      <SectionHeading
        id="need-title"
        eyebrow="The hidden disease"
        index="01"
        title="Remission isn’t the finish line. MRD is where AML relapse begins."
        lead="Therapy can push acute myeloid leukaemia below what a microscope can see — but measurable residual disease (MRD) survives, and it drives relapse. Once relapse occurs, survival is poor, and transplantation remains costly and out of reach for many. No AML-specific therapy exists to eliminate MRD early."
      />
      <div class="need__grid">
        <div class="need__figure bezel" data-reveal>
          <BioVisual
            variant="mrd"
            label="Graph of leukaemic burden over time: treatment pushes disease below the microscopy limit, residual disease hides there and relapses, unless γδ T cells given in the intervention window drive it to MRD-negative"
          />
        </div>
        <div class="need__stats">
          {amlNeed.map((s) => <Stat {...s} tone="dark" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- TiCoBi -->
  <section class="section ticobi" id="ticobi" aria-labelledby="ticobi-title">
    <div class="container">
      <div class="ticobi__grid">
        <div class="ticobi__copy">
          <SectionHeading id="ticobi-title" eyebrow="The platform" index="02" size="md" title={`${ticobi.name} — ${ticobi.expansion}`} lead={ticobi.summary} />
          <ul class="chips" aria-label="TiCoBi characteristics" data-reveal>
            {
              ticobi.attributes.map((a) => (
                <li>
                  <Icon name="check" size={14} />
                  {a}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="ticobi__figure bezel" data-reveal>
          <BioVisual
            variant="ticobi"
            label="Schematic: blood from one healthy donor passes through a time-controlled expansion chamber and yields up to fifteen off-the-shelf γδ T-cell doses"
          />
        </div>
      </div>
      <div class="ticobi__rail">
        <ProcessRail steps={ticobi.steps} label="How TiCoBi works" />
      </div>
    </div>
  </section>

  <!-- Mechanism + comparison -->
  <section class="section section--alt" id="why" aria-labelledby="why-title">
    <div class="container">
      <SectionHeading
        id="why-title"
        eyebrow="Immune cells that find leukaemia without a map"
        index="03"
        title="Why γδ T cells"
        lead="Immune-mediated elimination of leukaemia is most likely to work when disease burden is minimal — before overt relapse and an increasingly immunosuppressive microenvironment."
      />
      <div class="mech">
        <div class="mech__figure bezel" data-reveal>
          <BioVisual
            variant="hero"
            label="Schematic of a γδ T cell using its γδ T-cell receptor and NKG2D to recognise MICA/B and ULBP stress ligands on a leukaemic cell"
          />
        </div>
        <ul class="mech__list">
          {
            mechanism.map((m) => (
              <li class="mech__item" data-reveal>
                <span class="mech__icon">
                  <Icon name={m.icon} size={22} />
                </span>
                <div>
                  <h3>{m.title}</h3>
                  <p>{m.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="matrix" data-reveal>
        <table>
          <caption class="visually-hidden">How TiCoBi compares with today’s CAR-T approaches</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Attribute</span></th>
              {comparison.columns.map((c, i) => <th scope="col" class:list={{ 'is-ours': i === comparison.columns.length - 1 }}>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              comparison.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.values.map((v, i) => (
                    <td class:list={{ 'is-ours': i === r.values.length - 1 }} data-label={comparison.columns[i]}>{v}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="section" id="pipeline" aria-labelledby="pipeline-title">
    <div class="container">
      <SectionHeading
        id="pipeline-title"
        eyebrow="Product portfolio"
        index="04"
        title="One platform, a growing pipeline"
        lead="TiCoBi is antigen-agnostic. Beyond AML, the same process extends to glioblastoma and other solid tumours — and TiCoBi-generated γδ T cells can also supply partners’ CAR-T programmes."
      />
      <div class="pipeline" role="table" aria-label="Product pipeline" data-reveal>
        <div class="pipeline__head" role="row">
          <span role="columnheader">Programme</span>
          <span role="columnheader">Indication</span>
          <span role="columnheader">Modality</span>
          <span role="columnheader">Focus</span>
        </div>
        {
          pipeline.map((p) => (
            <div class:list={['prog', { 'prog--lead': p.lead }]} role="row">
              <div class="prog__id" role="cell">
                <span class="prog__code">{p.code}</span>
                {p.lead && (
                  <span class="prog__badge">
                    <span class="prog__pulse" aria-hidden="true" />
                    Lead programme
                  </span>
                )}
              </div>
              <div class="prog__main" role="cell">
                <h3>{p.indication}</h3>
                <p class="prog__detail">{p.detail}</p>
              </div>
              <div class="prog__modality" role="cell">
                <span class="prog__label">Modality</span>
                <strong>{p.modality}</strong>
                <span class="prog__platform">{p.platform}</span>
              </div>
              <ul class="prog__tags" role="cell" aria-label="Therapeutic focus">
                {p.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pillars in depth -->
  <section class="section section--alt" id="principles" aria-labelledby="pillars-title">
    <div class="container">
      <SectionHeading
        id="pillars-title"
        eyebrow="Platform principles"
        index="05"
        title="Our three-pillar approach"
      >
        <p class="pillars-kicker" aria-label="Affordable, scalable, accessible">
          <span>Affordable.</span> <span>Scalable.</span> <span>Accessible.</span>
        </p>
      </SectionHeading>

      <div class="rows">
        {
          pillars.map((p, i) => (
            <article class:list={['row', { 'row--flip': i % 2 === 1 }]} id={p.id} aria-labelledby={`${p.id}-title`}>
              <div class="row__media bezel" data-reveal>
                <BioVisual variant={p.visual} label={p.visualLabel} />
              </div>
              <div class="row__copy" data-reveal>
                <span class="row__icon">
                  <Icon name={p.icon} />
                </span>
                <p class="row__index">Pillar 0{i + 1}</p>
                <h3 id={`${p.id}-title`}>{p.title}</h3>
                <p class="row__metric">{p.metric}</p>
                <p class="row__body">{p.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Point of care: comparison + PoCMAP advantages -->
  <section class="section" id="point-of-care" aria-labelledby="compare-title">
    <div class="container">
      <SectionHeading
        id="compare-title"
        eyebrow="Point-of-care with PoCMAP"
        index="06"
        title="Shorter journeys from cell to patient"
        lead="Decentralising manufacturing to the hospital reduces logistics and freeze–thaw cycles."
      />

      <div class="compare">
        <figure class="flow flow--muted" data-reveal>
          <figcaption>
            <span class="flow__tag">Conventional</span>
            Centralised manufacturing
          </figcaption>
          <ol>
            {
              centralised.map((s) => (
                <li>
                  <span class="flow__dot"><Icon name={s.icon} size={18} /></span>
                  {s.label}
                </li>
              ))
            }
          </ol>
        </figure>

        <figure class="flow flow--brand" data-reveal>
          <figcaption>
            <span class="flow__tag">Thrafford</span>
            Point-of-care with PoCMAP
          </figcaption>
          <ol>
            {
              pointOfCare.map((s) => (
                <li>
                  <span class="flow__dot"><Icon name={s.icon} size={18} /></span>
                  {s.label}
                </li>
              ))
            }
          </ol>
        </figure>
      </div>

      <div class="unit-block">
        <div class="unit-block__copy">
          <h3 class="sub-title" id="adv-title" data-reveal>A modular platform built for hospitals</h3>
          <ol class="adv">
            {
              pocmapAdvantages.map((a, i) => (
                <li class="adv__item" data-reveal>
                  <span class="adv__num">{i + 1}</span>
                  <div>
                    <h4>{a.title}</h4>
                    <p>{a.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <figure class="unit" data-reveal aria-labelledby="unit-cap">
          <figcaption id="unit-cap" class="unit__cap">
            <span>Schematic</span> A PoCMAP unit inside the treating hospital
          </figcaption>

          <div class="unit__site">
            <span class="unit__site-label">
              <Icon name="hospital" size={16} /> Hospital <span class="unit__pin">1</span>
            </span>

            <div class="unit__line">
              <div class="unit__stage">
                <span class="unit__stage-icon"><Icon name="user" size={20} /></span>
                <strong>Cell intake</strong>
                <span>Collected on site</span>
              </div>

              <span class="unit__arrow" aria-hidden="true"></span>

              <div class="unit__stage unit__stage--bays">
                <strong>Parallel batch bays <span class="unit__pin">2</span></strong>
                <ul class="unit__bays">
                  <li><span>CAR-T</span><i style="--w: 78%"></i></li>
                  <li><span>NK</span><i style="--w: 52%"></i></li>
                  <li><span>Dendritic</span><i style="--w: 64%"></i></li>
                </ul>
                <span class="unit__note">Same platform, different cell systems <span class="unit__pin">3</span></span>
              </div>

              <span class="unit__arrow" aria-hidden="true"></span>

              <div class="unit__stage">
                <span class="unit__stage-icon unit__stage-icon--teal"><Icon name="check" size={20} /></span>
                <strong>In-line QC <span class="unit__pin">4</span></strong>
                <span>Real-time sterility &amp; quality checks</span>
              </div>

              <span class="unit__arrow" aria-hidden="true"></span>

              <div class="unit__stage">
                <span class="unit__stage-icon"><Icon name="hospital" size={20} /></span>
                <strong>Treatment</strong>
                <span>Same hospital</span>
              </div>
            </div>

            <p class="unit__journey">
              <span class="unit__pin">5</span>
              Cell to patient without leaving the building: no inter-site shipping and fewer freeze–thaw cycles.
            </p>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <!-- Intellectual property -->
  <section class="section section--alt ip" id="patents" aria-labelledby="ip-title">
    <div class="container">
      <SectionHeading
        id="ip-title"
        eyebrow="Intellectual property"
        index="07"
        title="Protected by design"
        lead="Our moat combines patent-filed manufacturing with trade-secret process logic — an integrated value chain that takes years of validation to rebuild."
      />
      <ol class="patents">
        {
          patents.map((p, i) => (
            <li class="patent" data-reveal>
              <div class="patent__top">
                <span class="patent__idx">P-0{i + 1}</span>
                <span class="patent__status">
                  <span class="patent__dot" aria-hidden="true" />
                  Patent filed
                </span>
              </div>
              <p class="patent__label">Application No.</p>
              <p class="patent__no">{p.number}</p>
              <h3>{p.title}</h3>
            </li>
          ))
        }
      </ol>
      <ul class="moat" aria-label="Competitive advantages">
        {
          moat.map((m) => (
            <li data-reveal>
              <Icon name={m.icon} size={18} />
              {m.title}
            </li>
          ))
        }
      </ul>
      <p class="ip__more" data-reveal>
        <a href="/publications/#patent">See the team’s full patent record <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- Applications -->
  <section class="section section--dark apps" id="applications" aria-labelledby="apps-title">
    <div class="container apps__grid">
      <div>
        <SectionHeading
          id="apps-title"
          eyebrow="Applications"
          index="08"
          size="md"
          title="One platform, many cell therapies"
          lead="Our reagent-agnostic design reaches across oncology and autoimmune disease. Longer term, our AI and quantum computation initiative designs and optimises targets, algorithms and processes."
        />
        <ul class="apps__list">
          {
            applications.map((a) => (
              <li data-reveal>
                <span class="apps__icon">
                  <Icon name={a.icon} size={22} />
                </span>
                {a.title}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="apps__image bezel" data-reveal>
        <BioVisual variant="genome" label="Schematic of a DNA double helix with a highlighted gene-editing site" />
      </div>
    </div>
  </section>

  <CTABand
    title="Partner with us on TiCoBi"
    body="Talk to us about clinical partnerships, our γδ T-cell programmes, or supplying γδ T cells for your CAR-T pipeline."
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .th {
    position: relative;
    padding-top: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    background: var(--ink-950);
    color: var(--ink-100);
    overflow: hidden;
    isolation: isolate;
  }

  .th__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(760px 460px at 82% 18%, rgb(53 87 222 / 0.26), transparent 70%),
      radial-gradient(620px 420px at 8% 100%, rgb(18 158 150 / 0.18), transparent 70%),
      var(--gradient-dark);
  }

  .th__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000, transparent 75%);
  }

  .th__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
  }

  .th__copy {
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }

  .th h1 {
    font-size: clamp(2.4rem, 1.3rem + 3.4vw, 4.4rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--white);
  }

  .th__accent {
    background: linear-gradient(90deg, #8fa6ff, #63d2ca);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .th__lead {
    max-width: 54ch;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--ink-200);
  }

  .th__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }

  /* Spec panel: an instrument read-out */
  .spec {
    position: relative;
    display: grid;
    gap: var(--sp-5);
    padding: var(--sp-6);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 22px;
    background: linear-gradient(160deg, rgb(28 39 52 / 0.92), rgb(12 17 24 / 0.96));
    box-shadow:
      0 0 0 6px rgb(255 255 255 / 0.03),
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 40px 80px -30px rgb(0 0 0 / 0.7);
    animation: th-in 1100ms var(--ease) both;
  }

  @keyframes th-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  .spec__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .spec__title,
  .spec__status,
  .spec figcaption,
  .spec dt,
  .spec__cp text {
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .spec__title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-200);
  }

  .spec__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgb(95 212 207 / 0.35);
    border-radius: var(--radius-pill);
    background: rgb(95 212 207 / 0.1);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--teal-300);
    white-space: nowrap;
  }

  .spec__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-300);
    animation: th-blink 1.8s ease-in-out infinite;
  }

  @keyframes th-blink {
    50% {
      opacity: 0.25;
    }
  }

  .spec__chart {
    margin: 0;
    padding: var(--sp-4);
    border: 1px solid rgb(255 255 255 / 0.07);
    border-radius: 14px;
    background: rgb(0 0 0 / 0.22);
  }

  .spec__chart svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .spec__cp text {
    fill: var(--teal-300);
    font-size: 8px;
  }

  .spec__cp {
    opacity: 0;
    animation: th-fade 600ms var(--ease) forwards;
    animation-delay: calc(0.9s + var(--i) * 0.35s);
  }

  .spec__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: th-draw 2.2s var(--ease) 0.5s forwards;
  }

  .spec__area {
    opacity: 0;
    animation: th-fade 1.2s var(--ease) 1.6s forwards;
  }

  .spec__end {
    opacity: 0;
    animation:
      th-fade 400ms var(--ease) 2.5s forwards,
      th-blink 1.8s ease-in-out 3s infinite;
  }

  @keyframes th-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes th-fade {
    to {
      opacity: 1;
    }
  }

  .spec figcaption {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    font-size: 0.5625rem;
    color: var(--ink-400);
  }

  .spec__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }

  .spec__list > div {
    display: grid;
    gap: 0.15rem;
    padding: var(--sp-3) 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .spec__list > div:nth-child(odd) {
    padding-right: var(--sp-4);
  }

  .spec__list > div:nth-child(even) {
    padding-left: var(--sp-4);
    border-left: 1px solid rgb(255 255 255 / 0.08);
  }

  .spec__list > div:nth-last-child(-n + 2) {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .spec dt {
    font-size: 0.625rem;
    color: var(--ink-400);
  }

  .spec dd {
    margin: 0;
    font-weight: 600;
    color: var(--white);
  }

  /* Chapter index */
  .th__index {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .th__index ol {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    border-top: 1px solid rgb(255 255 255 / 0.1);
    list-style: none;
  }

  .th__index a {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: var(--sp-4) var(--sp-3) var(--sp-5) 0;
    border-top: 2px solid transparent;
    margin-top: -1px;
    color: var(--ink-200);
    font-size: var(--fs-sm);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .th__index a span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--ink-400);
    transition: color var(--dur) var(--ease);
  }

  .th__index a:hover {
    color: var(--white);
    border-top-color: var(--teal-300);
  }

  .th__index a:hover span {
    color: var(--teal-300);
  }

  @media (max-width: 1000px) {
    .th__grid {
      grid-template-columns: 1fr;
    }

    .th__index ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .spec {
      padding: var(--sp-5) var(--sp-4);
    }

    .spec__list {
      grid-template-columns: 1fr;
    }

    .spec__list > div:nth-child(n) {
      padding-inline: 0;
      border-left: 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }

    .spec__list > div:last-child {
      border-bottom: 0;
    }

    .th__index ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 01 · Unmet need */
  .need__grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .need__figure {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 750 / 520;
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6);
  }

  .need__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-5);
  }

  @media (max-width: 960px) {
    .need__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .need__stats {
      grid-template-columns: 1fr;
    }
  }

  /* 02 · TiCoBi */
  .ticobi {
    scroll-margin-top: var(--header-h);
  }

  .ticobi__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .ticobi__copy :global(.section-heading) {
    margin-bottom: var(--sp-6);
  }

  .ticobi__figure {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 750 / 520;
    box-shadow: var(--shadow-lg);
  }

  .ticobi__rail {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.85);
    border-radius: var(--radius-pill);
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .chips li :global(svg) {
    color: var(--teal-700);
  }

  @media (max-width: 960px) {
    .ticobi__grid {
      grid-template-columns: 1fr;
    }
  }

  /* 03 · Mechanism + comparison */
  .mech {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .mech__figure {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 750 / 620;
    box-shadow: var(--shadow-lg);
  }

  .mech__list {
    display: grid;
    gap: var(--sp-4);
    list-style: none;
  }

  .mech__item {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-5);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .mech__icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--gradient-brand);
    color: var(--white);
  }

  .mech__item h3 {
    font-size: var(--fs-lg);
    margin-bottom: var(--sp-1);
  }

  .mech__item p {
    color: var(--text-muted);
  }

  .matrix {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    overflow-x: auto;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .matrix table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .matrix th,
  .matrix td {
    padding: var(--sp-4) var(--sp-5);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }

  .matrix tbody tr:last-child > * {
    border-bottom: 0;
  }

  .matrix thead th {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 800;
    color: var(--ink-900);
  }

  .matrix tbody th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-500);
    white-space: nowrap;
  }

  .matrix td {
    color: var(--ink-700);
  }

  .matrix .is-ours {
    background: linear-gradient(180deg, rgb(38 67 196 / 0.07), rgb(18 158 150 / 0.07));
    color: var(--blue-700);
    font-weight: 700;
  }

  .matrix thead .is-ours {
    background: var(--gradient-brand);
    color: var(--white);
  }

  /* Phones: each attribute becomes a card listing the three approaches, labelled inline. */
  @media (max-width: 640px) {
    .matrix {
      overflow: visible;
    }

    .matrix table {
      min-width: 0;
    }

    .matrix thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .matrix tr,
    .matrix th,
    .matrix td {
      display: block;
    }

    .matrix tbody tr {
      padding: var(--sp-4) var(--sp-4) var(--sp-2);
      border-bottom: 1px solid var(--border);
    }

    .matrix tbody tr:last-child {
      border-bottom: 0;
    }

    .matrix th,
    .matrix td {
      padding: 0;
      border: 0;
    }

    .matrix tbody th {
      margin-bottom: var(--sp-2);
      white-space: normal;
    }

    .matrix td {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--sp-3);
      padding: 0.55rem 0.65rem;
      border-radius: 10px;
    }

    .matrix td::before {
      content: attr(data-label);
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--ink-500);
    }
  }

  @media (max-width: 960px) {
    .mech {
      grid-template-columns: 1fr;
    }
  }

  /* 04 · Pipeline */
  /* 04 · Pipeline table */
  .pipeline {
    --cols: minmax(150px, 0.8fr) minmax(0, 2.2fr) minmax(0, 1.1fr) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
  }

  .pipeline__head,
  .prog {
    display: grid;
    grid-template-columns: var(--cols);
    gap: var(--sp-6);
    padding-inline: clamp(1.25rem, 0.5rem + 2vw, 2.25rem);
  }

  .pipeline__head {
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--border);
    background: rgb(255 255 255 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .prog {
    position: relative;
    align-items: start;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    transition: background-color var(--dur) var(--ease);
  }

  .prog + .prog {
    border-top: 1px solid var(--border);
  }

  .prog:hover {
    background: rgb(255 255 255 / 0.5);
  }

  /* Lead programme: a dark, instrument-panel row. */
  .prog--lead {
    background:
      radial-gradient(520px 220px at 92% 0%, rgb(69 101 230 / 0.32), transparent 70%),
      radial-gradient(420px 200px at 0% 100%, rgb(18 158 150 / 0.18), transparent 70%),
      linear-gradient(160deg, #141b23, #0a0e13);
    color: var(--ink-100);
  }

  .prog--lead:hover {
    background:
      radial-gradient(520px 220px at 92% 0%, rgb(69 101 230 / 0.4), transparent 70%),
      radial-gradient(420px 200px at 0% 100%, rgb(18 158 150 / 0.22), transparent 70%),
      linear-gradient(160deg, #141b23, #0a0e13);
  }

  .prog--lead::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--gradient-brand);
  }

  .prog__id {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
    padding-top: 0.35rem;
  }

  .prog__code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--blue-600);
  }

  .prog--lead .prog__code {
    color: var(--teal-300);
  }

  .prog__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgb(95 212 207 / 0.35);
    border-radius: var(--radius-pill);
    background: rgb(95 212 207 / 0.1);
    color: var(--teal-300);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .prog__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-300);
    box-shadow: 0 0 0 0 rgb(99 210 202 / 0.6);
    animation: prog-pulse 2.4s var(--ease) infinite;
  }

  @keyframes prog-pulse {
    70%,
    100% {
      box-shadow: 0 0 0 7px rgb(99 210 202 / 0);
    }
  }

  .prog__main h3 {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .prog--lead .prog__main h3 {
    color: var(--white);
  }

  .prog__detail {
    margin-top: var(--sp-2);
    max-width: 52ch;
    color: var(--text-muted);
  }

  .prog--lead .prog__detail {
    color: var(--ink-200);
  }

  .prog__modality {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.35rem;
  }

  .prog__label {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .prog__modality strong {
    font-weight: 600;
    color: var(--ink-900);
  }

  .prog--lead .prog__modality strong {
    color: var(--white);
  }

  .prog__platform {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-500);
  }

  .prog--lead .prog__platform {
    color: var(--ink-400);
  }

  .prog__tags {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: var(--sp-2);
    padding-top: 0.25rem;
    list-style: none;
  }

  .prog__tags li {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .prog--lead .prog__tags li {
    background: rgb(255 255 255 / 0.08);
    color: var(--ink-100);
  }

  @media (max-width: 900px) {
    .pipeline__head {
      display: none;
    }

    .prog {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }

    .prog__id {
      grid-auto-flow: column;
      align-items: center;
      justify-content: start;
      padding-top: 0;
    }

    .prog__label {
      display: block;
    }
  }

  .sub-title {
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 var(--sp-6);
    font-size: var(--fs-2xl);
    letter-spacing: -0.03em;
  }

  /* 07 · Intellectual property */
  .ip {
    scroll-margin-top: var(--header-h);
  }

  .patents {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
    list-style: none;
  }

  .patent {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--sp-2);
    padding: var(--sp-6);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 100% 22px,
      linear-gradient(160deg, #141b23, #0a0e13);
    border: 1px solid rgb(143 166 255 / 0.22);
    color: var(--ink-100);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .patent::after {
    content: '';
    position: absolute;
    right: -60px;
    top: -60px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(69 101 230 / 0.35), transparent 70%);
  }

  .patent__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-4);
  }

  .patent__idx {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-400);
  }

  .patent__status {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid rgb(95 212 207 / 0.35);
    border-radius: var(--radius-pill);
    background: rgb(95 212 207 / 0.1);
    color: var(--teal-300);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .patent__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--teal-300);
    box-shadow: 0 0 8px var(--teal-300);
  }

  .patent__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .patent__no {
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    background: linear-gradient(90deg, #8fa6ff, #63d2ca);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .patent h3 {
    margin-top: var(--sp-3);
    padding-top: var(--sp-4);
    border-top: 1px dashed rgb(255 255 255 / 0.14);
    font-size: var(--fs-lg);
    line-height: 1.35;
    color: var(--white);
  }

  .moat {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    list-style: none;
  }

  .moat li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    background: var(--glass-bg);
    box-shadow: var(--glass-highlight), var(--shadow-soft);
    font-weight: 600;
    font-size: var(--fs-sm);
    line-height: 1.35;
    color: var(--ink-900);
  }

  .moat li :global(svg) {
    flex-shrink: 0;
    color: var(--blue-600);
  }

  .ip__more {
    margin-top: var(--sp-6);
  }

  .ip__more a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 700;
    color: var(--blue-600);
    text-decoration: none;
  }

  .ip__more a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 960px) {
    .patents {
      grid-template-columns: 1fr;
    }

    .moat {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .moat {
      grid-template-columns: 1fr;
    }
  }

  .pillars-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5ch;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .pillars-kicker span {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Pillar rows */
  .rows {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .row--flip .row__media {
    order: 2;
  }

  .row__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--ink-100);
  }

  .row__media {
    box-shadow: var(--shadow-lg);
  }

  .row__copy {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }

  .row__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--gradient-brand);
    color: var(--white);
    margin-bottom: var(--sp-2);
  }

  .row__index {
    font-family: var(--font-mono) !important;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .row h3 {
    font-size: var(--fs-2xl);
  }

  .row__metric {
    font-family: var(--font-display);
